# Commit message lint (大厂标配 — 强制 conventional commit 格式)
# 例: feat: add OAuth Google login
#     fix: jwt blacklist memory leak
#     docs: update README
#     chore: bump deps
#     refactor: split user service
#     test: add e2e for login flow
#     perf: cache user lookup
#
# V2026-11-11 M-2 治本：原实现为 `npx --no -- commitlint --edit "$1"`。但 @commitlint/cli
# 从未安装（node_modules/@commitlint/cli 不存在、package.json 无该依赖），该句每次提交
# 必然失败并空转约 13.4 秒（实测 19630 / 13487 / 13376 ms），格式校验实际从未生效。
# 改为纯 shell 正则校验：零新增依赖、微秒级，并真正阻断不合规消息。

MSG_FILE="$1"

# 取首个有效行（跳过注释与空行）作为提交标题
FIRST_LINE=$(grep -v '^#' "$MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1)

# 放行 git 自动生成的提交（merge / revert / fixup / squash）
case "$FIRST_LINE" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*)
    exit 0
    ;;
esac

if printf '%s\n' "$FIRST_LINE" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([^)]+\))?: .+'; then
  exit 0
fi

echo "⚠️  commit-msg format should follow conventional commits:"
echo "    feat: add new feature"
echo "    fix: bug fix"
echo "    docs: documentation only"
echo "    style: formatting, no code change"
echo "    refactor: code change that neither fixes a bug nor adds a feature"
echo "    perf: performance improvement"
echo "    test: add/fix tests"
echo "    chore: build / ci / deps changes"
echo ""
echo "    (blocked by .husky/commit-msg regex check — V2026-11-11 M-2)"
exit 1