# AF-498 · 本地 pre-push 分层闸门
#
# 全量 `verify:local`（lint + typecheck + 4953 例测试）只在任务收尾与 CI 跑一次。
# 每次 push 都跑全量会让十余次推送累计十分钟级等待；push 只需要挡住「本次改动
# 明确引入的失败」：lint + typecheck + 受影响测试。
#
# 边界不变：
#   1. 编排器跨机锁 ref 不跑闸门；
#   2. 跑测试前清掉 Git 注入的 GIT_DIR / GIT_INDEX_FILE；
#   3. 禁止 --no-verify 绕过；全量测试由 CI required checks 兜底。

skip=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/orchestration-lock) ;;
    *) skip=1 ;;
  esac
done

if [ "$skip" -eq 0 ]; then
  exit 0
fi

for var in $(git rev-parse --local-env-vars | tr -d '\r'); do
  unset "$var"
done
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

# 只改文档 / 状态面 / 记录包：不触发代码闸门。实现是否完整由任务收尾全量验证与 CI 判。
base_ref="origin/integrate"
merge_base=$(git merge-base "$base_ref" HEAD 2>/dev/null || true)
if [ -n "$merge_base" ]; then
  changed=$(git diff --name-only "$merge_base" HEAD 2>/dev/null || true)
else
  changed=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || true)
fi
code_changed=$(printf '%s\n' "$changed" | grep -E '^(src|test|bin|scripts|admin-dashboard)/|^(package\.json|tsconfig.*\.json|vitest.*\.(ts|mts|js)|pnpm-lock\.yaml)$' || true)
if [ -z "$code_changed" ]; then
  echo "[pre-push] 本次只改文档/状态/记录，跳过代码闸门（全量由 CI 兜底）"
  exit 0
fi

pnpm lint || exit 1
pnpm typecheck || exit 1
pnpm exec vitest run --changed "$base_ref" --exclude '**/e2e/**/*.ts' || exit 1
