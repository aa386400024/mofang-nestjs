# AF-378 · 本地 pre-push 权威闸门
#
# 目的：把 lint / typecheck / 全量单测前移到本地，避免同一类失败反复触发
# GitHub Actions 全量 CI，消耗私有仓 2,000 分钟额度。
#
# 两个必须处理的边界：
#   1. 编排器的跨机单写者锁通过 `git push refs/heads/orchestration-lock` 抢锁；
#      这条引用不是代码，不能让钩子跑全量，否则 run-once 永远抢不到远端锁。
#   2. Git 在钩子里会注入 GIT_DIR / GIT_INDEX_FILE 等局部变量；全量测试里有
#      创建临时仓库的用例，若不清理这些变量，测试会把提交写进当前仓库。
#      跑闸门前先 unset，保证测试只在临时目录里操作。
#
# 不在钩子里跑 coverage：coverage 只在 R2/ready PR 的 CI 上执行。
# 禁止使用 --no-verify 绕过。

skip=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/orchestration-lock) ;;
    *) skip=1 ;;
  esac
done

if [ "$skip" -eq 0 ]; then
  exit 0
fi

for var in $(git rev-parse --local-env-vars | tr -d '\r'); do
  unset "$var"
done
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

pnpm verify:local
