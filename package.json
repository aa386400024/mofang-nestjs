{
  "name": "nestjs-project-structure",
  "version": "0.0.0",
  "description": "Node.js framework NestJS project structure",
  "main": "dist/app.js",
  "// V2026-11-02 ESM migration": "package.json type=module 后, .cjs 文件仍按 CommonJS 解析, .js/.mjs 按 ESM. scripts 下 ensure-utf8/smoke-*/deploy-* 保留 .cjs 后缀不动.",
  "type": "module",
  "imports": {
    "#entity/*": "./dist/entity/*"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@9.15.0",
  "engineStrict": true,
  "scripts": {
    "lint": "eslint --cache \"{src,test,bin}/**/*.ts\"",
    "lint:fix": "eslint --fix --cache \"{src,test,bin}/**/*.ts\"",
    "lint:fast": "oxlint src test bin",
    "lint:fast:fix": "oxlint --fix src test bin",
    "lint:deep": "oxlint --type-aware src test bin",
    "typecheck": "tsc -b tsconfig.check.json",
    "typecheck:full": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "doctor:fs": "node scripts/fs-latency-check.mjs",
    "prepare": "husky || true",
    "lint-staged": "lint-staged",
    "entity:load": "tsx bin/entity.ts",
    "entity:sync": "tsx node_modules/typeorm/cli.js -d bin/ormconfig.ts schema:sync",
    "migration:generate": "tsx node_modules/typeorm/cli.js -d bin/ormconfig.ts migration:generate",
    "migration:create": "tsx node_modules/typeorm/cli.js migration:create",
    "migration:run": "tsx node_modules/typeorm/cli.js -d bin/ormconfig.ts migration:run",
    "seed:training": "tsx bin/seed-training-exercises.ts",
    "seed:practice": "tsx bin/seed-practice-scenarios.ts",
    "seed:quotes": "tsx bin/seed-quotes.ts",
    "seed:visitor-pool": "tsx bin/seed-visitor-pool-templates.ts",
    "seed:character-profiles": "tsx bin/seed-character-profiles.ts",
    "seed:quality-annotations": "tsx bin/seed-quality-annotations.ts",
    "seed:counselor-modes": "tsx bin/seed-counselor-modes.ts",
    "seed:visitors-jsonl": "tsx bin/seed-visitors-jsonl.ts",
    "migration:revert": "tsx node_modules/typeorm/cli.js -d bin/ormconfig.ts migration:revert",
    "migration:show": "tsx node_modules/typeorm/cli.js -d bin/ormconfig.ts migration:show",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "node scripts/ensure-utf8.cjs && pnpm build",
    "start": "node dist/app.js",
    "start:dev": "nest start --watch",
    "start:win": "node scripts/ensure-utf8.cjs && nest start --watch",
    "test:smoke": "node scripts/smoke-test.cjs && node -e \"import('node:fs').then(fs=>fs.writeFileSync('.smoke-last', new Date().toISOString()))\"",
    "smoke:iw": "pnpm build && node scripts/smoke-inner-world.cjs && node -e \"import('node:fs').then(fs=>fs.writeFileSync('.smoke-iw-last', new Date().toISOString()))\"",
    "deploy:tested": "node scripts/deploy-tested.cjs",
    "start:debug": "nest start --debug --watch",
    "start:repl": "nest start --entryFile repl",
    "test": "vitest run --exclude '**/e2e/**/*.ts'",
    "test:fast": "vitest run --config ./vitest.fast.config.mts --exclude '**/e2e/**/*.ts'",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related",
    "test:e2e": "vitest run --config ./test/vitest.e2e.mts",
    "doc": "compodoc -p tsconfig.json -s -d docs",
    "doc:api": "pnpm build && node dist/swagger.js",
    "smoke:ai": "pnpm build && node scripts/smoke-ai-engine.cjs && node -e \"import('node:fs').then(fs=>fs.writeFileSync('.smoke-ai-last', new Date().toISOString()))\"",
    "smoke:rag": "pnpm build && node scripts/smoke-rag.cjs && node -e \"import('node:fs').then(fs=>fs.writeFileSync('.smoke-rag-last', new Date().toISOString()))\""
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "@qdrant/js-client-rest": "^1.19.0",
    "@sentry/node": "^11.10.0",
    "@sentry/profiling-node": "^11.10.0",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.20.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^9.15.1",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "mysql2": "^3.24.4",
    "nanoid": "^6.0.2",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^6.4.24",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/prompts": "^2.4.9",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "neostandard": "^0.13.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typeorm-model-generator": "^0.4.6-no-engines",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CatsMiaow/nestjs-project-structure.git"
  },
  "keywords": [
    "Node.js",
    "NestJS",
    "TypeScript"
  ],
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "test/**/*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "bin/**/*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "scripts/**/*.{mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "homepage": "https://github.com/CatsMiaow/nestjs-project-structure#readme",
  "author": "CatsMiaow",
  "license": "MIT"
}
