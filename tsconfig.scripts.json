{
  // V2026-10-20 治本 (运维脚本专用 tsconfig — bin/ 目录):
  //
  //   为什么需要独立一份:
  //     tsconfig.json 是应用用的, 没有 rootDir; tsconfig.build.json 有 rootDir: 'src',
  //     但它 exclude 掉了 bin/**. 两者都不适配 bin/ 下的脚本:
  //       - 用 tsconfig.json  → TS5011 (入口在 bin/, 依赖跨 src/, 公共源目录推断为 ./bin)
  //       - 用 tsconfig.build.json → 该文件 exclude bin/**, 与'运行 bin 脚本'的意图矛盾
  //     改应用用的 tsconfig.json 去加 rootDir 会波及 nest build 的产物布局 (dist/ 层级),
  //     属于超出本次范围的高风险改动. 故独立一份, 语义清晰且零副作用.
  //
  //   rootDir 设为 '.' 是关键: 脚本入口在 bin/, 被编译文件跨 bin/ 与 src/,
  //   公共源目录就是仓库根, 显式声明后 TS5011 消除.
  //
  //   用法: ts-node -T -P tsconfig.scripts.json <script>
  //   时间戳: 2026-10-20
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["typings/global.d.ts", "src/**/*", "bin/**/*"],
  "exclude": ["node_modules", "dist"]
}
