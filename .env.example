# ===== JWT 密钥 =====
# V1.0 dev 用这个固定值 (生产必须换长随机串)
JWT_SECRET=xin-su-dev-secret-change-in-production-please-use-32-bytes-random
JWT_REFRESH_SECRET=xin-su-dev-refresh-secret-change-in-production-32-bytes-random

# ===== SMTP 邮件服务 (复用 mofang-nestjs 现有 shared EmailService) =====
# dev 模式 EMAIL_ENABLED=false 时, 验证码只走 Logger 不发邮件
# 生产必须 EMAIL_ENABLED=true 配置真 SMTP
#
# Gmail 例子:
#   1. https://myaccount.google.com/apppasswords 开启 2FA + 生成应用密码
#   2. EMAIL_USER=your.email@gmail.com
#   3. EMAIL_PASS=xxxx-xxxx-xxxx-xxxx  (16 位应用密码)
#
# 网易 163 例子 (推荐国内 dev):
#   EMAIL_HOST=smtp.163.com
#   EMAIL_PORT=465
#   EMAIL_USER=你的163账号@163.com
#   EMAIL_PASS=16位授权码 (设置 → POP3/SMTP/IMAP → 客户端授权码)
#
# Mailtrap 例子 (dev 推荐 — 不真发, 沙盒看 Inbox):
#   EMAIL_HOST=sandbox.smtp.mailtrap.io
#   EMAIL_PORT=2525
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=心塑