# ============================================================================
# 部署契约 (Deployment contract) — V2026-11-03 治本 (WP25 · Phase1 封版审查)
# ----------------------------------------------------------------------------
# 本文件是**部署契约**: 运维 / 内测操作者唯一能看到的"这个服务能配什么"的清单.
#
#   · **生效行** (=KEY=)  ↔  代码里真实读取的一个 env 键, **一一对应**;
#   · **注释行**            = 说明 / 预留键 (当前代码未接线), 不构成契约.
#
#   为什么用机器守住 (而不是靠人记得同步):
#     两头漂移的代价不对称, 且**都不报错**:
#       · 漏键 (代码读, 模板没有) → 部署时配不上, 功能默默用默认值;
#       · 多键 (模板有, 代码不读) → 改了半天不生效, 排查成本极高.
#     守卫: test/config/wp25-env-example-coverage.spec.ts (双向断言, 违反即测试变红).
#     **改这个文件后请跑那条测试.**
#
#   值的三种写法:
#     · 密钥 / 密码 / token → 留空 (空 = 代码走"未配置"分支, 由代码自己 fail-fast 或告警)
#     · 数值 → 填**代码里的默认值** (照抄即可得到与代码一致的行为)
#     · 开关 (xxx_ENABLED) → true / false
# ============================================================================

# ===== 运行模式与端口 =====
# ⚠️ NODE_ENV 必须保持**注释**状态: 本地照抄本文件不能开 production 模式.
#    生产请在部署环境单独注入 NODE_ENV=production.
# NODE_ENV=development
# 服务监听端口 (默认 3000).
PORT=3000
# Swagger 独立进程端口 (默认 8000; 只在单独起 swagger.ts 时用).
SWAGGER_PORT=8000
# 容器时区 (影响"当日 token 预算"的自然日边界 + 统计口径). 缺省 = UTC.
TZ=Asia/Shanghai
# 允许的跨域来源 (逗号分隔). 生产**必须**显式列举 —— 留空 = 只允许同源.
#   dev 缺省是 '*'; 生产缺省是 '' (不放行任何跨域).
CORS_ORIGINS=
# express-session 密钥.
#   ⚠️ 生产**必须**配: 不配时服务端会生成一个随机密钥并打 error 日志
#      (每次重启都变, 已登录的会话全部失效). 这套 session 只服务已弃用的
#      /auth/* passport demo —— 正式鉴权全走 JWT.
SESSION_SECRET=

# ===== 数据库 (MySQL) =====
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ===== Redis (JWT 黑名单 / BullMQ 队列 / 验证码 / 限流 / 缓存) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# key 前缀 (多环境隔离用).
REDIS_KEY_PREFIX=mofang

# ===== JWT 密钥 =====
# V1.0 dev 用这个固定值 (生产必须换长随机串)
JWT_SECRET=xin-su-dev-secret-change-in-production-please-use-32-bytes-random
JWT_REFRESH_SECRET=xin-su-dev-refresh-secret-change-in-production-32-bytes-random
# 有效期 (支持 900 / 7d / 12h 这类写法). 缺省: access 15min / refresh 7d.
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ===== SMTP 邮件服务 (复用 mofang-nestjs 现有 shared EmailService) =====
# dev 模式 EMAIL_ENABLED=false 时, 验证码只走 Logger 不发邮件
# 生产必须 EMAIL_ENABLED=true 配置真 SMTP
#
# Gmail 例子:
#   1. https://myaccount.google.com/apppasswords 开启 2FA + 生成应用密码
#   2. EMAIL_USER=your.email@gmail.com
#   3. EMAIL_PASS=xxxx-xxxx-xxxx-xxxx  (16 位应用密码)
#
# 网易 163 例子 (推荐国内 dev):
#   EMAIL_HOST=smtp.163.com
#   EMAIL_PORT=465
#   EMAIL_USER=你的163账号@163.com
#   EMAIL_PASS=16位授权码 (设置 → POP3/SMTP/IMAP → 客户端授权码)
#
# Mailtrap 例子 (dev 推荐 — 不真发, 沙盒看 Inbox):
#   EMAIL_HOST=sandbox.smtp.mailtrap.io
#   EMAIL_PORT=2525
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=心塑
# 邮箱验证 token 有效期 (分钟, 默认 30).
EMAIL_TOKEN_TTL_MIN=30

# ===== 短信 (验证码通道) =====
# provider: mock | aliyun | tencent | twilio (缺省 mock —— 不真发).
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=Mofang
SMS_TEMPLATE_CODE=
SMS_REGION=
# 验证码有效期 (分钟, 默认 5) / 位数 (默认 6) / 单手机号每小时上限 (默认 10).
SMS_CODE_TTL_MIN=5
SMS_CODE_LENGTH=6
SMS_RATE_LIMIT_PER_HOUR=10

# ===== OAuth 第三方登录 =====
# 三个 provider 都是"关 = 不启用"; 开启时对应的 *_APP_ID / *_APP_SECRET 必填.
WECHAT_OAUTH_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=http://localhost:3000/user/oauth/wechat/callback
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/user/oauth/google/callback
APPLE_OAUTH_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM 字符串 (Apple 的 .p8 内容).
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://mofang.cloud/user/oauth/apple/callback

# ===== 密码策略 (大厂生产标准, NIST 800-63B + 国内合规) =====
# 不允许复用最近 N 次 / 强制重置周期 (天) / 改密最小间隔 (分钟) /
# 失败锁定阈值 / 锁定时长 (分钟).
PASSWORD_HISTORY_LIMIT=5
PASSWORD_RESET_CYCLE_DAYS=90
PASSWORD_MIN_AGE_MINUTES=0
PASSWORD_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=30
# 密码重置 token 有效期 (分钟, 默认 60).
PASSWORD_RESET_TOKEN_TTL_MIN=60

# ===== Soft delete (GDPR 合规) =====
# 软删保留天数 + 清理 cron.
SOFT_DELETE_RETENTION_DAYS=30
SOFT_DELETE_CRON=0 3 * * *

# ===== 合规 / 可观测 =====
# 同意记录版本号: 升级此版本号 → 强制客户端重弹同意 dialog (后端权威).
CONSENT_CURRENT_VERSION=v1.0
# Prometheus 指标端点. ⚠️ 默认开启且**无鉴权** —— 见 WP25 扫描报告 P2 清单.
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Sentry (不配 DSN = 关闭上报).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# 线上发布标识 (Sentry release tag).
SENTRY_RELEASE=
# 采样率 (0-1).
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# ===== LLM 路由 (V6.0 §3 + §3.5) =====
# 服务端不内置 default api key (强制每用户在 ai-engine DB 配自己的 key;
# db > env > code 优先级, 详见 src/llm/registry/llm-router.service.ts).
#
# 至少配置 1 个 provider 的 api key, 否则 /v1/chat/completions 返回 503.
#
# ⚠️ 键名规律: LLM_<厂商大写>_API_KEY (OPENAI / DEEPSEEK / DOUBAO / QWEN / CUSTOM).
#    MiniMax 是**例外** —— 它走历史命名 MINIMAX_API_KEY (见下方 MiniMax 段),
#    刻意不改名 (改名会断掉已跑通的语音链路).
LLM_DEEPSEEK_API_KEY=
LLM_DOUBAO_API_KEY=
LLM_QWEN_API_KEY=
LLM_OPENAI_API_KEY=
LLM_CUSTOM_API_KEY=
# 默认 chat / embedding provider (openai / deepseek / doubao / qwen / custom / minimax).
#   缺省: chat = deepseek, embedding = qwen.
LLM_DEFAULT_CHAT_PROVIDER=deepseek
LLM_DEFAULT_EMBEDDING_PROVIDER=openai

# ===== MiniMax 文本模型 (V1.2 VS-A — 督导反馈真接 LLM) =====
# counselor 端 (咨询师学员端) 的 LLM 分析链路 (督导反馈 / 知情同意判定 / 实时轻提示 /
# 技术统计 / 档案抽取) 走 MiniMax 栈 (src/agent/llm/llm.service.ts, OpenAI 兼容协议).
#
# 生效模型优先级: MINIMAX_COUNSELOR_LLM_MODEL > MINIMAX_LLM_MODEL > 代码默认.
# 缺省 = MiniMax-M3.1-Flash (1M 上下文, 思考深度可调, 大炮 2026-10-21 拍板).
#
# 为什么要独立一个 counselor 变量而不是只改 MINIMAX_LLM_MODEL:
#   1) MINIMAX_LLM_MODEL 是 visitor / supervisor / llm.controller / counselor 全局共用的值;
#   2) counselor 分析链路对输出稳定性 / token 预算的要求跟对话链路不同, 需要独立旋钮.
#
# 注意 1: 思考深度 reasoning_effort 仅 M3.1-Flash 生效, 换成 M3 时会被自动忽略
#         (见 src/counselor/config/counselor-llm.config.ts 的 supportsReasoningEffort).
# 注意 2: M3.1-Flash 会忽略 temperature / top_p (固定 1 / 0.95), 确定性靠 prompt 约束.
# 注意 3: 若 MINIMAX_BASE_URL 指向的域名未开通 M3.1-Flash, 上游会返 404/400,
#         把两个模型变量都改成 MiniMax-M3 即可.
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_API_KEY=
MINIMAX_LLM_MODEL=MiniMax-M3.1-Flash
MINIMAX_COUNSELOR_LLM_MODEL=MiniMax-M3.1-Flash
# 60s: M3.1-Flash 强制 adaptive thinking (思考 token 计入输出上限), 首 token 延迟高于 M3.
# 叠加重试上限 3 次 (MINIMAX_LLM_MAX_RETRIES).
MINIMAX_LLM_TIMEOUT_MS=60000
MINIMAX_LLM_MAX_RETRIES=2

# ===== MiniMax 语音转写 (STT) — V2026-10-23 语音微训练 STT 代理 =====
# STT 复用上面的全局 MINIMAX_BASE_URL / MINIMAX_API_KEY (同一个上游, 不另开配置位).
#   国内: https://api.minimax.cn    国际: https://api.minimax.io
# key 类型不写死: 按量 API Key 与 M Plan 订阅 Key 都可填, 由部署环境按实际账户决定.
# 转写超时 (与 LLM 超时隔离) / 本地体积与时长上限 (默认与上游一致)
MINIMAX_ASR_TIMEOUT_MS=30000
MINIMAX_ASR_MAX_FILE_BYTES=52428800
MINIMAX_ASR_MAX_DURATION_SEC=500
# STT 代理签发的客户端 token: 密钥 + 有效期 (秒). 客户端直连上游时用.
MINIMAX_ASR_TOKEN_SECRET=
MINIMAX_ASR_TOKEN_TTL_SEC=300
# 端点级限流: 单用户每分钟转写次数 (按 userId, 不按 IP) + 限流窗口 (毫秒).
PRACTICE_ASR_RATE_LIMIT_PER_MINUTE=10
PRACTICE_ASR_RATE_LIMIT_WINDOW_MS=60000

# ===== MiniMax 语音合成 (TTS) 双向流式 — V2026-10-23 全真会谈逐句出声 =====
# 协议: wss://api.minimax.cn/ws/v1/t2a_v2_bidi (官方 T2A V2)
#   - 纯 JSON 文本帧, 帧类型字段是 `event`; 音频在 task_continued.data.audio (hex mp3 分片)
#   - 后端按句攒齐 mp3 再下发 (前端播完整句, web/native 双端兼容)
#   - 完整规格: docs/specs/counselor-roleplay-voice-bidi-tts-2026-10-23.md
# 复用上面的全局 MINIMAX_BASE_URL / MINIMAX_API_KEY (同一个上游, 不另开 key).
#
# 模型: 官方枚举只有 turbo / hd 后缀, `speech-2.8` (无后缀) **不存在**, 用了必被 2013 拒.
MINIMAX_TTS_MODEL=speech-2.8-turbo
# 音色 (voice_id): 必填, 从官方「系统音色列表」选一个自然中文女声填入 (调试台试听确认).
#   本项目**不给默认值** —— 未核实的占位音色会合成出"能播但不像人"的音频, 排查成本高.
#   未配置时: voice 模式回 error(tts_config_invalid); text 模式不受影响.
#   官方文档里公开给出的中文音色 id (可直接复制, 最终选哪个以试听为准):
#     Chinese (Mandarin)_Lyrical_Voice
#     Chinese (Mandarin)_HK_Flight_Attendant
MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Lyrical_Voice
# 语言增强 (官方枚举: Chinese / English 等).
MINIMAX_TTS_LANGUAGE_BOOST=Chinese
# 语速 / 音量 / 音调 (官方值域: speed 0.5-2 / vol 0-10 / pitch -12~12)
MINIMAX_TTS_SPEED=1
MINIMAX_TTS_VOLUME=1
MINIMAX_TTS_PITCH=0
# 音频参数: mp3 / 32000Hz / 单声道
MINIMAX_TTS_SAMPLE_RATE=32000
MINIMAX_TTS_BITRATE=128000
# 建连 + 握手超时 (等 connected_success / task_started)
MINIMAX_TTS_TIMEOUT_MS=30000
# 单句最大字符数 (超长句强制切; 兼作上游 2204 的本地防线)
MINIMAX_TTS_MAX_SENTENCE_CHARS=100
# 保活 ping 间隔 (官方不主动 ping, 120s 空闲会以 2201 断开); 0 = 关闭
MINIMAX_TTS_KEEPALIVE_MS=30000
# 连接池: 并发上限 (跟 MiniMax 单账号并发限制对齐) + acquire 排队超时
MINIMAX_TTS_MAX_CONNECTIONS=100
MINIMAX_TTS_ACQUIRE_TIMEOUT_MS=10000
# 官方音色目录代理: 查询超时 / 握手里建议性校验超时 / 内存缓存 TTL (毫秒).
MINIMAX_VOICES_TIMEOUT_MS=15000
MINIMAX_VOICES_CHECK_TIMEOUT_MS=3000
MINIMAX_VOICES_CACHE_TTL_MS=600000

# ===== Embedding 服务 (Phase 6 接入) =====
#   - provider 切换不改 schema (bge / chatanywhere 都是 1024 维)
#   - 用户已提供 2 个 chatanywhere key, 通过 EMBEDDING_API_KEY / EMBEDDING_API_KEY_MPLAN env 注入
#   - bge 自托管 URL 走容器内网, 生产推荐
EMBEDDING_PROVIDER_DEV=chatanywhere
EMBEDDING_PROVIDER_PROD=bge_large_zh
EMBEDDING_API_KEY=
EMBEDDING_API_KEY_MPLAN=
EMBEDDING_BGE_URL=http://bge-embedding.internal:8080
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024

# ===== Qdrant 向量库 (V6.0 §12 RAG) =====
# docker run -p 6333:6333 -v /tmp/qdrant_storage:/qdrant/storage qdrant/qdrant
# 生产环境推荐启用 QDRANT_API_KEY (Qdrant 1.x 支持鉴权).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# 知识库 chunk 集合 (engine-adapters 的记忆仓储默认用它).
QDRANT_COLLECTION=knowledge_chunks
# 知识库检索用的集合 (ai-engine / knowledge-base 侧) —— 与上面是**两个**集合.
QDRANT_KB_COLLECTION=knowledge_chunks
# 知识库向量检索开关 (false = 只走 LIKE 软降级).
KB_VECTOR_SEARCH_ENABLED=true

# ===== RAG 切块 (V2026-10-15 治本 · VS-3 续) =====
#   RAG_AUTO_EMBED: publish 成功时是否自动向量化写 Qdrant (默认 true). 设 false 走
#     V0.x 行为 (search 走 LIKE 软降级).
#   RAG_CHUNK_SIZE / RAG_CHUNK_OVERLAP: LangChain RecursiveCharacterTextSplitter 参数,
#     默认 200 / 20 (1 KB 文档约 5 chunk).
#   LLM_DEFAULT_EMBEDDING_PROVIDER: 走 OpenAI 兼容 4 provider 之一, 与上面的
#     LLM_DEFAULT_EMBEDDING_PROVIDER 是同一个键 (embedding 专用口径).
RAG_AUTO_EMBED=true
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=20

# ===== PsyGUARD 风险探测服务 (V2026-10-30 · WP11) =====
# 独立仓库 mofang-psyguard 的 PsyGUARD-RoBERTa 中文危机风险分类服务 (FastAPI + ONNX Runtime).
#
# 留空 = **不启用** (行为与现状逐字一致: 用本地规则探测器 LocalCrisisProbe).
# 配了 = 改用 HTTP 探测器打这个地址; 服务不可达/超时/503 一律静默回落本地规则, 不阻断对话.
#
# 生产部署 (同机 host 网络): 只绑 127.0.0.1, 不对外暴露.
#   docker compose up -d   (在 /opt/mofang-psyguard)
#   PSYGUARD_BASE_URL=http://127.0.0.1:8100
#
# ⚠️ 探测预算: 内核 assessSafety 的探测超时是**硬上限** (engine-core 红线, 适配层改不动),
#    服务必须在该上限内答完 —— 否则探测恒定回落本地规则 (服务在跑但等于没接).
#    正式口径是 150ms; 当前内核常量被临时放宽到 500ms (见下方临时值说明).
#    下方超时只是**提前掐断 HTTP 连接**, 调大它不会放宽内核的判定上限.
#
# ⚠️⚠️ **临时值 500 —— M3 内测前必须改回 150** (WP11 审核后决策 #4: 测试阶段只有一个人用,
#    准确率优先于延迟, 同时把服务侧 token 窗口放宽到 256).
#    500 是内核 `DEFAULT_PROBE_TIMEOUT_MS` 当前的**同一个**临时值 —— 两侧必须一致,
#    否则会出现"内核等 500ms、HTTP 150ms 就掐了"这种自相矛盾的口径.
PSYGUARD_BASE_URL=
PSYGUARD_TIMEOUT_MS=500

# ===== 记忆衰减 / 召回配置 (V2026-10-30 · WP12) =====
# 长时记忆的"重要度衰减"与"召回门槛"两个工程种子值 —— 集中在一处配置, 不散落.
#
# MEMORY_DECAY_HALF_LIFE_DAYS: 重要度衰减半衰期 (天). 默认 30 (与内核常量同值).
#   越小 = 旧记忆淡出越快 (学员回来时引擎想不起上次); 越大 = 记得越久.
# MEMORY_RECALL_THRESHOLD: 访客范围召回的有效重要度门槛 [0,1]. 默认 0.1 (与内核常量同值).
#   越大 = 只召回"更重要"的记忆 (噪音少, 但可能想不起来).
#
# ⚠️ 这两个值**只对 Qdrant 版记忆仓储生效** (纯内存版的召回判定在内核里).
# ⚠️ 内核那道地板改不动 (WP12 红线: 不改 src/engine-core/**), 所以阈值**只能收紧**:
#    配成 < 0.1 不会让内核放行 (内核仍按 0.1 卡一道), 配成 > 0.1 会在 B 层额外加一道.
#    非法值 (非数字 / ≤0 / >1) 一律回退默认值, 不抛错 —— 填错 env 不该让服务起不来.
#
# ⚠️ 这两个值是**工程种子值, 未标定** —— 后期靠真实训练数据校准, 不是临床结论.
MEMORY_DECAY_HALF_LIFE_DAYS=30
MEMORY_RECALL_THRESHOLD=0.1

# 会话摘要用的模型名 (收尾时把本场逐字稿压成 ≤200 字摘要, 再晋升为长时记忆).
# 留空 = 用 LLM 路由的 RAG 分层默认模型 (各家厂商的模型名只有路由知道, 这里不硬编码).
# 配错 = 摘要生成失败 → 记 warn, 本场不晋升长时记忆 (不影响会话正常结束).
MEMORY_SUMMARY_MODEL=

# ===== 单场成本日志 (V2026-10-30 · WP24) =====
# 内测期防烧 LLM 额度用: 每场会话结束打一条 `session_cost_summary` 结构化日志,
# 里面有本场总 token 与预估费用. 定价做成 env 是因为**厂商调价是外部事实** ——
# 写死在代码里意味着每次调价都要发一次版.
#
# 单位: 元 / 千 token (不是元 / token, 也不是元 / 百万 token).
# 公式: estimatedCostCny = (totalPromptTokens/1000)*输入价 + (totalCompletionTokens/1000)*输出价
#
# ⚠️ **输入侧用量在流式路径不可得** (上游只给累计 tokenCount, 没有 prompt/completion
#    拆分) —— 这时成本口径会如实落成 `costBasis: "output_only"`, 即**只含输出侧**,
#    是全场成本的下界. 读日志时先看 costBasis,  别把它当全场成本.
#
# ⚠️ 这两个值是**工程默认值**, 不是与厂商合同核对过的报价 —— 真正计费以厂商账单为准.
#    非法值 (空串 / 非数字 / 负数) 一律回退默认值, 不抛错 —— 填错 env 不该让服务起不来.
LLM_PRICE_INPUT_PER_1K=0.0015
LLM_PRICE_OUTPUT_PER_1K=0.0045

# ===== 督导报告 (V2026-10-26 / WP21) =====
# 主报告是**异步**生成的 (BullMQ + LLM). 这些是"陈旧 pending"判定与 SSE 推送的参数.
#   缺省值在 counselor/config/supervision.config.ts (单一真值源), 这里只声明"本地怎么跑"的可调项.
SUPERVISION_REPORT_PENDING_TIMEOUT_MS=300000
SUPERVISION_MIN_EFFECTIVE_TURNS=3
SUPERVISION_MIN_EFFECTIVE_CHARS=200
SUPERVISION_REPORT_STREAM_POLL_INTERVAL_MS=2000
SUPERVISION_REPORT_STREAM_TIMEOUT_MS=120000

# ===== 督导主报告 LLM 参数 (agent/supervisor) =====
# 主报告的思考深度 / 生成长度上限 / 超时窗口.
#   思考深度合法档位: low / medium / high / xhigh / max (非法 → 回落 high).
#   数值非法或非正 → 回退缺省值.
ENGINE_SUPERVISION_REASONING_EFFORT=high
ENGINE_SUPERVISION_MAX_TOKENS=8192
ENGINE_SUPERVISION_TIMEOUT_MS=120000

# ===== 练习端 LLM 开关与限额 (counselor) =====
# 两个**语义正交**的开关, 都缺省 on (保持既有行为). 置 off = 不发起任何对应调用:
#   · PRACTICE_LLM_EVALUATION  → §3.3 评判 (evaluateWithLlm); off 时走确定性关键词路径,
#                                 接口形状不变;
#   · PRACTICE_LLM_GENERATION  → P2 来访者反应 + §3.5/§7.2 场景生成; off 时走模板降级.
# ⚠️ 别把 EVALUATION=off 理解成"把练习引擎的 LLM 成本关掉" —— 生成链路照旧烧钱.
PRACTICE_LLM_EVALUATION=on
PRACTICE_LLM_GENERATION=on
# 自定义私有场景: 每用户每天生成次数上限 / 私有场景存量上限 / 生成时限 (毫秒).
#   非法或非正 → 回退缺省值 (5 / 50 / 8000).
PRACTICE_CUSTOM_SCENARIO_DAILY_LIMIT=5
PRACTICE_CUSTOM_SCENARIO_MAX_COUNT=50
PRACTICE_CUSTOM_SCENARIO_GENERATION_TIMEOUT_MS=8000
# 访客人设批量生成条数上限 (env 覆盖, 硬顶 5; 非法或非正 → 回退 1).
VISITOR_POOL_GENERATE_MAX_COUNT=1

# ===== 语音对练 · 断线重连追平 (V2026-11-03 · WP23) =====
# 这两个值服务的是**断线重连**这条路: 客户端重连时带 `lastSeenTurnIndex`,
# 服务端把漏掉的轮次一次性补回去 (`session_catchup` 帧).
#
# ⚠️ VOICE_SESSION_IDLE_TIMEOUT_MINUTES 的语义是"内存卫生兜底", **不是**断连宽限期:
#    断连本身不挂任何定时器 (断线不杀会话, 重连即补漏); 这个计时器只管
#    "从最后一次收到客户端消息算起, 多久没人理就主动收尾" —— 一场没人理的对练
#    不该在内存里挂两小时.
#    单位: **分钟** (不是毫秒).
# ⚠️ 非法值 (非数字 / 0 / 负数) 一律回退默认值, 不照用 ——
#    0 会让兜底立刻触发 (会话秒死), 非法值会让兜底形同虚设.
VOICE_SESSION_IDLE_TIMEOUT_MINUTES=120
# 重连时最多补几轮. 漏的轮次超过它就不补 (推 `session_stale`, reason=too_far_behind),
# 让客户端自己从头开始 —— 一次塞两百条历史既塞不进 UI, 也让"补漏"变成"灌数据".
# ⚠️ 非法值 (非数字 / 0 / 负数) 一律回退默认值 20.
VOICE_CATCHUP_MAX_TURNS=20
# ⚠️ VOICE_SESSION_IDLE_TIMEOUT_MS (毫秒) 是 Phase 3 留下的**死配置**:
#    代码里读得到它, 但**没有任何地方消费** `voice.sessionIdleTimeoutMs`.
#    真正生效的是上面的 VOICE_SESSION_IDLE_TIMEOUT_MINUTES (单位分钟).
#    保留是因为它仍在 config 层被读取 —— 但**别拿它配超时**.
VOICE_SESSION_IDLE_TIMEOUT_MS=600000

# ===== 语音对练 · 限流与灰度 (WP22 / WP8-B) =====
# 全局**当日** completion token 预算 (0 = 不限制). 内测期防"bug 循环 / 恶意刷"烧额度.
VOICE_DAILY_TOKEN_BUDGET=500000
# 单用户并发语音会话上限 (本期恒为 1; 留这个 env 是为了以后放开时不必改代码结构).
VOICE_MAX_CONCURRENT_PER_USER=1
# 灰度开关: 新引擎是否接管语音链路. 缺省 false —— 旧链路 100% 原样, 可一键回退.
ENGINE_VOICE_ENABLED=false
# 灰度会话白名单 (逗号分隔的 sessionId). 空 = 总开关打开即全量.
ENGINE_STREAM_GRAYSCALE_SESSIONS=

# ===== 引擎调试与调参 (WP9-A / WP15 / WP19-R) =====
# 引擎逐轮留痕 (trace) 开关. 缺省关 —— 开了会显著增加落库量.
# ⚠️ 留痕是"BDI 快照可还原"的前提 (WP19-R): 进程重启后想还原上一场会话的
#    BDI 状态, 依赖这份逐轮 trace. 生产关着 = 重启后还原不了.
ENGINE_DEBUG_TRACE_ENABLED=false
# 角色数据源: db (缺省, MySQL 角色池) | builtin (回退/测试档).
ENGINE_CHARACTER_SOURCE=db

# ----- 单回合非对称 delta cap (WP15 · 9 维 × 2 方向 = 18 个键) -----
# 键名: ENGINE_CAP_<维度>_UP / ENGINE_CAP_<维度>_DOWN.
#   维度: TRUST / VALENCE / AROUSAL / VERBAL / DEPTH / STYLE / POSITIVE / NEGATIVE / DEPENDENCY.
# 语义: 一回合内 BDI 各维度的**最大变动幅度** (正 delta 砍到上向, 负 delta 砍到下向).
#   信任 / 情绪效价: 上 +0.20 / 下 -0.30 (损失厌恶 —— 信任建得慢、破得快)
#   唤醒度 / 阻抗三维: ±0.20 (对称)
#   移情三维:          ±0.15 (移情涨得慢)
# ⚠️ 非法值 (空串 / 非数字 / 符号与方向不符) 一律回退种子值 —— 配错一个 env
#    不该让整场对练的 BDI 迁移失真.
# ⚠️ 这些键在 src/engine-core 内核里读取 (内核唯一一处 env 依赖), 属**进程级配置**:
#    同一 seed + 同一行为序列, 在不同 cap 配置下会落到不同状态 (回放不可跨环境对拍).
ENGINE_CAP_TRUST_UP=0.2
ENGINE_CAP_TRUST_DOWN=-0.3
ENGINE_CAP_VALENCE_UP=0.2
ENGINE_CAP_VALENCE_DOWN=-0.3
ENGINE_CAP_AROUSAL_UP=0.2
ENGINE_CAP_AROUSAL_DOWN=-0.2
ENGINE_CAP_VERBAL_UP=0.2
ENGINE_CAP_VERBAL_DOWN=-0.2
ENGINE_CAP_DEPTH_UP=0.2
ENGINE_CAP_DEPTH_DOWN=-0.2
ENGINE_CAP_STYLE_UP=0.2
ENGINE_CAP_STYLE_DOWN=-0.2
ENGINE_CAP_POSITIVE_UP=0.15
ENGINE_CAP_POSITIVE_DOWN=-0.15
ENGINE_CAP_NEGATIVE_UP=0.15
ENGINE_CAP_NEGATIVE_DOWN=-0.15
ENGINE_CAP_DEPENDENCY_UP=0.15
ENGINE_CAP_DEPENDENCY_DOWN=-0.15

# ===== 上传与静态资源 (头像等) =====
# 头像等上传文件的本地存储目录 (相对路径按 process.cwd() 解析).
#   dev = ./uploads; 生产建议 /var/www/mofang/uploads (由 nginx 直接 serve).
UPLOAD_STORAGE_DIR=./uploads
# 上传文件的对外可访问基址 (前端拼完整 URL 用). 留空 = 走相对路径.
UPLOAD_PUBLIC_BASE_URL=

# ===== 管理后台 basic auth (admin-debug 模块) =====
# ⚠️ **生产必须配**, 否则匿名请求会被直接 401 (WP25 已把生产改成 fail-close).
#    留空 = dev 放行 / 生产拒绝 —— 生产放行等于把整场逐字稿公开.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASS=

# ===== RSA 字段级加密 (V1.1 企业字段加密) =====
# 生产从 .env 加载固定 keypair; dev 每次启动自动生成 (启动 log 有警告).
#   公钥: SPKI PEM; 私钥: PKCS8 PEM.
# ⚠️ .env 里写多行 PEM 时, 服务端会把 literal "\n" 还原成真换行
#    (兼容 9P mount cache / Windows CRLF / dotenv 的各种 parse 行为).
RSA_PUBLIC_KEY_PEM=
RSA_PRIVATE_KEY_PEM=

