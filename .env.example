# LLM_TIER_BASIC_PROVIDER=openai
# LLM_TIER_PRO_PROVIDER=deepseek
# LLM_TIER_RAG_PROVIDER=openai
# LLM_HTTP_TIMEOUT_MS=30000
# LLM_STREAM_CHUNK_SIZE=64
#
