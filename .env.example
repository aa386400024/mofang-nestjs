# AI_UNLOCK_BASELINE_EMERGENCY=2
# AI_UNLOCK_BASELINE_LIFE_MAP=3
# AI_UNLOCK_BASELINE_DEEP_DIVE=5
# AI_UNLOCK_BASELINE_GAMIFIED=3
# AI_UNLOCK_BASELINE_RECOMMEND=2
