# ===== JWT 密钥 =====
# V1.0 dev 用这个固定值 (生产必须换长随机串)
JWT_SECRET=xin-su-dev-secret-change-in-production-please-use-32-bytes-random
JWT_REFRESH_SECRET=xin-su-dev-refresh-secret-change-in-production-32-bytes-random

# ===== SMTP 邮件服务 (复用 mofang-nestjs 现有 shared EmailService) =====
# dev 模式 EMAIL_ENABLED=false 时, 验证码只走 Logger 不发邮件
# 生产必须 EMAIL_ENABLED=true 配置真 SMTP
#
# Gmail 例子:
#   1. https://myaccount.google.com/apppasswords 开启 2FA + 生成应用密码
#   2. EMAIL_USER=your.email@gmail.com
#   3. EMAIL_PASS=xxxx-xxxx-xxxx-xxxx  (16 位应用密码)
#
# 网易 163 例子 (推荐国内 dev):
#   EMAIL_HOST=smtp.163.com
#   EMAIL_PORT=465
#   EMAIL_USER=你的163账号@163.com
#   EMAIL_PASS=16位授权码 (设置 → POP3/SMTP/IMAP → 客户端授权码)
#
# Mailtrap 例子 (dev 推荐 — 不真发, 沙盒看 Inbox):
#   EMAIL_HOST=sandbox.smtp.mailtrap.io
#   EMAIL_PORT=2525
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=心塑
# ===== LLM / AI 引擎 (V6.0 §3 + §3.5) =====
# LLM 路由 — 默认 basic tier 走 OpenAI 兼容协议.
# 服务端不内置 default api key (强制每用户在 ai-engine DB 配自己的 key;
# db > env > code 优先级, 详见 src/llm/registry/llm-router.service.ts).
#
# 至少配置 1 个 provider, 否则 /v1/chat/completions 返回 503.
#
# ----- OpenAI (海外, 默认) -----
LLM_OPENAI_ENABLED=true
LLM_OPENAI_API_KEY=
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_DEFAULT_MODEL_CHAT=gpt-4o-mini
LLM_OPENAI_DEFAULT_MODEL_EMBED=text-embedding-3-small
LLM_OPENAI_DIMENSION=1536

# ----- DeepSeek (国内, 性价比) -----
LLM_DEEPSEEK_ENABLED=false
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_DEFAULT_MODEL_CHAT=deepseek-chat
LLM_DEEPSEEK_DEFAULT_MODEL_EMBED=

# ----- 豆包 (火山引擎, 国内合规) -----
LLM_DOUBAO_ENABLED=false
LLM_DOUBAO_API_KEY=
LLM_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_DOUBAO_DEFAULT_MODEL_CHAT=doubao-pro-32k
LLM_DOUBAO_DEFAULT_MODEL_EMBED=doubao-embedding
LLM_DOUBAO_DIMENSION=2048

# ----- 通义千问 (阿里云, 国内合规) -----
LLM_QWEN_ENABLED=false
LLM_QWEN_API_KEY=
LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_QWEN_DEFAULT_MODEL_CHAT=qwen-plus
LLM_QWEN_DEFAULT_MODEL_EMBED=text-embedding-v3
LLM_QWEN_DIMENSION=1024

# ----- 自定义 (测试 / 自托管) -----
LLM_CUSTOM_ENABLED=false
LLM_CUSTOM_API_KEY=
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_DEFAULT_MODEL_CHAT=
LLM_CUSTOM_DEFAULT_MODEL_EMBED=

# LLM tier → provider 路由 (basic → OpenAI / pro → DeepSeek 等, 默认 OpenAI).
LLM_TIER_BASIC_PROVIDER=openai
LLM_TIER_PRO_PROVIDER=deepseek
LLM_TIER_RAG_PROVIDER=openai

# 通用参数
LLM_HTTP_TIMEOUT_MS=30000
LLM_STREAM_CHUNK_SIZE=64

# ===== MiniMax 文本模型 (V1.2 VS-A — 督导反馈真接 LLM) =====
# counselor 端 (咨询师学员端) 的 LLM 分析链路 (督导反馈 / 知情同意判定 / 实时轻提示 /
# 技术统计 / 档案抽取) 走 MiniMax 栈 (src/agent/llm/llm.service.ts, OpenAI 兼容协议).
#
# 生效模型优先级: MINIMAX_COUNSELOR_LLM_MODEL > MINIMAX_LLM_MODEL > 代码默认.
# 缺省 = MiniMax-M3.1-Flash (1M 上下文, 思考深度可调, 大炮 2026-10-21 拍板).
#
# 为什么要独立一个 counselor 变量而不是只改 MINIMAX_LLM_MODEL:
#   1) MINIMAX_LLM_MODEL 是 visitor / supervisor / llm.controller / counselor 全局共用的值;
#   2) counselor 分析链路对输出稳定性 / token 预算的要求跟对话链路不同, 需要独立旋钮.
#
# 注意 1: 思考深度 reasoning_effort 仅 M3.1-Flash 生效, 换成 M3 时会被自动忽略
#         (见 src/counselor/config/counselor-llm.config.ts 的 supportsReasoningEffort).
# 注意 2: M3.1-Flash 会忽略 temperature / top_p (固定 1 / 0.95), 确定性靠 prompt 约束.
# 注意 3: 若 MINIMAX_BASE_URL 指向的域名未开通 M3.1-Flash, 上游会返 404/400,
#         把两个模型变量都改成 MiniMax-M3 即可.
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_LLM_MODEL=MiniMax-M3.1-Flash
MINIMAX_COUNSELOR_LLM_MODEL=MiniMax-M3.1-Flash
# 60s: M3.1-Flash 强制 adaptive thinking (思考 token 计入输出上限), 首 token 延迟高于 M3.
# 叠加重试上限 3 次 (MINIMAX_LLM_MAX_RETRIES).
MINIMAX_LLM_TIMEOUT_MS=60000
MINIMAX_LLM_MAX_RETRIES=2
MINIMAX_API_KEY=

# ===== MiniMax 语音转写 (STT) — V2026-10-23 语音微训练 STT 代理 =====
# STT 复用上面的全局 MINIMAX_BASE_URL / MINIMAX_API_KEY (同一个上游, 不另开配置位).
#   国内: https://api.minimax.cn    国际: https://api.minimax.io
# key 类型不写死: 按量 API Key 与 M Plan 订阅 Key 都可填, 由部署环境按实际账户决定.
# 转写超时 (与 LLM 超时隔离) / 本地体积与时长上限 (默认与上游一致)
# MINIMAX_ASR_TIMEOUT_MS=30000
# MINIMAX_ASR_MAX_FILE_BYTES=52428800
# MINIMAX_ASR_MAX_DURATION_SEC=500
# 端点级限流: 单用户每分钟转写次数 (按 userId, 不按 IP)
# PRACTICE_ASR_RATE_LIMIT_PER_MINUTE=10

# ===== MiniMax 语音合成 (TTS) 双向流式 — V2026-10-23 全真会谈逐句出声 =====
# 协议: wss://api.minimax.cn/ws/v1/t2a_v2_bidi (官方 T2A V2)
#   - 纯 JSON 文本帧, 帧类型字段是 `event`; 音频在 task_continued.data.audio (hex mp3 分片)
#   - 后端按句攒齐 mp3 再下发 (前端播完整句, web/native 双端兼容)
#   - 完整规格: docs/specs/counselor-roleplay-voice-bidi-tts-2026-10-23.md
# 复用上面的全局 MINIMAX_BASE_URL / MINIMAX_API_KEY (同一个上游, 不另开 key).
#
# 模型: 官方枚举只有 turbo / hd 后缀, `speech-2.8` (无后缀) **不存在**, 用了必被 2013 拒.
MINIMAX_TTS_MODEL=speech-2.8-turbo
# 音色 (voice_id): 必填, 从官方「系统音色列表」选一个自然中文女声填入 (调试台试听确认).
#   本项目**不给默认值** —— 未核实的占位音色会合成出"能播但不像人"的音频, 排查成本高.
#   未配置时: voice 模式回 error(tts_config_invalid); text 模式不受影响.
#   官方文档里公开给出的中文音色 id (可直接复制, 最终选哪个以试听为准):
#     Chinese (Mandarin)_Lyrical_Voice
#     Chinese (Mandarin)_HK_Flight_Attendant
MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Lyrical_Voice
# 语速 / 音量 / 音调 (官方值域: speed 0.5-2 / vol 0-10 / pitch -12~12)
MINIMAX_TTS_SPEED=1
MINIMAX_TTS_VOLUME=1
MINIMAX_TTS_PITCH=0
# 音频参数: mp3 / 32000Hz / 单声道
MINIMAX_TTS_SAMPLE_RATE=32000
MINIMAX_TTS_BITRATE=128000
# 建连 + 握手超时 (等 connected_success / task_started)
MINIMAX_TTS_TIMEOUT_MS=30000
# 单句最大字符数 (超长句强制切; 兼作上游 2204 的本地防线)
MINIMAX_TTS_MAX_SENTENCE_CHARS=100
# 保活 ping 间隔 (官方不主动 ping, 120s 空闲会以 2201 断开); 0 = 关闭
MINIMAX_TTS_KEEPALIVE_MS=30000
# 连接池: 并发上限 (跟 MiniMax 单账号并发限制对齐) + acquire 排队超时
MINIMAX_TTS_MAX_CONNECTIONS=100
MINIMAX_TTS_ACQUIRE_TIMEOUT_MS=10000

# ===== Qdrant 向量库 (V6.0 §12 RAG) =====
# docker run -p 6333:6333 -v /tmp/qdrant_storage:/qdrant/storage qdrant/qdrant
# 生产环境推荐启用 QDRANT_API_KEY (Qdrant 1.x 支持鉴权).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# V2026-10-15 治本 (VS-3 续 写侧 — 知识库 publish 时自动切 chunk + embed + upsert 到 Qdrant):
#   RAG_AUTO_EMBED: publish 成功时是否自动向量化写 Qdrant (默认 true, 跟 V0.3 §17.2 W9
#     Phase 6 RAG 真联调默认开启一致). 设 false 走 V0.x 行为 (search 走 LIKE 软降级).
#   RAG_CHUNK_SIZE / RAG_CHUNK_OVERLAP: LangChain RecursiveCharacterTextSplitter 参数,
#     默认 200 / 20 (跟 V0.3 §13 knowledge_chunks 表 design doc 估 match, 1 KB 文档约 5 chunk).
#   LLM_DEFAULT_EMBEDDING_PROVIDER: 走 OpenAI 兼容 4 provider 之一 (openai/deepseek/doubao/qwen),
#     跟 LLM_TIER_RAG_PROVIDER 区分 (tier 路由是 chat 用途, 这里指 embedding 专用).
RAG_AUTO_EMBED=true
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=20
LLM_DEFAULT_EMBEDDING_PROVIDER=openai

# RAG 检索参数
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
RAG_COLLECTION_DEFAULT=psychology_articles
RAG_MAX_CONTEXT_CHARS=4000

# ===== Crisis 检测 (V6.0 §11.2) =====
# 关键词字典 (V2 用静态, V3 接 LLM 二级分类).
CRISIS_HIGH_KEYWORDS=自杀,自残,想死,不想活,结束生命,轻生
CRISIS_MEDIUM_KEYWORDS=绝望,崩溃,撑不下去,没意义,痛苦,想消失
CRISIS_LOW_KEYWORDS=难过,失落,孤单,焦虑,害怕,担心
CRISIS_HIGH_RESOURCE=全国24小时心理危机干预热线: 400-161-9995

# ===== AI 解锁评估 (V6.0 §3.3) =====
# 6 大高阶功能解锁 baseline 分数 (1-10), V3 接 RAG + LLM 后改成动态.
AI_UNLOCK_BASELINE_COMPANION=4
AI_UNLOCK_BASELINE_EMERGENCY=2
AI_UNLOCK_BASELINE_LIFE_MAP=3
AI_UNLOCK_BASELINE_DEEP_DIVE=5
AI_UNLOCK_BASELINE_GAMIFIED=3
AI_UNLOCK_BASELINE_RECOMMEND=2

# cron 跑评估周期 (ms); V2 默认 5 分钟, V3 接增量评估可放大到 1 小时.
AI_UNLOCK_EVALUATE_INTERVAL_MS=300000

# ===== 效果聚合 (V6.0 §3.4) =====
# 周维度 cron 跑时间 (CronExpression); V2 默认每周日 0 点.
EFFECT_AGGREGATE_WEEKLY_CRON=0 0 * * 0
# 月维度 cron 跑时间 (CronExpression); V2 默认每月 1 号 0 点.
EFFECT_AGGREGATE_MONTHLY_CRON=0 0 1 * *

# ===== Emergency 急救会话保留期 (V6.0 §4.2) =====
# 服务端镜像端侧 SQLCipher 本地表, 跨设备同步用. 保留 N 天后清理.
EMERGENCY_RETENTION_DAYS=365

# ===== PsyGUARD 风险探测服务 (V2026-10-30 · WP11) =====
# 独立仓库 mofang-psyguard 的 PsyGUARD-RoBERTa 中文危机风险分类服务 (FastAPI + ONNX Runtime).
#
# 留空 = **不启用** (行为与现状逐字一致: 用本地规则探测器 LocalCrisisProbe).
# 配了 = 改用 HTTP 探测器打这个地址; 服务不可达/超时/503 一律静默回落本地规则, 不阻断对话.
#
# 生产部署 (同机 host 网络): 只绑 127.0.0.1, 不对外暴露.
#   docker compose up -d   (在 /opt/mofang-psyguard)
#   PSYGUARD_BASE_URL=http://127.0.0.1:8100
#
# ⚠️ 探测预算: 内核 assessSafety 的探测超时是**硬上限** (engine-core 红线, 适配层改不动),
#    服务必须在该上限内答完 —— 否则探测恒定回落本地规则 (服务在跑但等于没接).
#    正式口径是 150ms; 当前内核常量被临时放宽到 500ms (见下方临时值说明).
#    下方超时只是**提前掐断 HTTP 连接**, 调大它不会放宽内核的判定上限.
#
# ⚠️⚠️ **临时值 500 —— M3 内测前必须改回 150** (WP11 审核后决策 #4: 测试阶段只有一个人用,
#    准确率优先于延迟, 同时把服务侧 token 窗口放宽到 256).
#    500 是内核 `DEFAULT_PROBE_TIMEOUT_MS` 当前的**同一个**临时值 —— 两侧必须一致,
#    否则会出现"内核等 500ms、HTTP 150ms 就掐了"这种自相矛盾的口径.
PSYGUARD_BASE_URL=
PSYGUARD_TIMEOUT_MS=500

# ===== 记忆衰减 / 召回配置 (V2026-10-30 · WP12) =====
# 长时记忆的"重要度衰减"与"召回门槛"两个工程种子值 —— 集中在一处配置, 不散落.
#
# MEMORY_DECAY_HALF_LIFE_DAYS: 重要度衰减半衰期 (天). 默认 30 (与内核常量同值).
#   越小 = 旧记忆淡出越快 (学员回来时引擎想不起上次); 越大 = 记得越久.
# MEMORY_RECALL_THRESHOLD: 访客范围召回的有效重要度门槛 [0,1]. 默认 0.1 (与内核常量同值).
#   越大 = 只召回"更重要"的记忆 (噪音少, 但可能想不起来).
#
# ⚠️ 这两个值**只对 Qdrant 版记忆仓储生效** (纯内存版的召回判定在内核里).
# ⚠️ 内核那道地板改不动 (WP12 红线: 不改 src/engine-core/**), 所以阈值**只能收紧**:
#    配成 < 0.1 不会让内核放行 (内核仍按 0.1 卡一道), 配成 > 0.1 会在 B 层额外加一道.
#    非法值 (非数字 / ≤0 / >1) 一律回退默认值, 不抛错 —— 填错 env 不该让服务起不来.
#
# ⚠️ 这两个值是**工程种子值, 未标定** —— 后期靠真实训练数据校准, 不是临床结论.
MEMORY_DECAY_HALF_LIFE_DAYS=30
MEMORY_RECALL_THRESHOLD=0.1

# 会话摘要用的模型名 (收尾时把本场逐字稿压成 ≤200 字摘要, 再晋升为长时记忆).
# 留空 = 用 LLM 路由的 RAG 分层默认模型 (各家厂商的模型名只有路由知道, 这里不硬编码).
# 配错 = 摘要生成失败 → 记 warn, 本场不晋升长时记忆 (不影响会话正常结束).
MEMORY_SUMMARY_MODEL=
