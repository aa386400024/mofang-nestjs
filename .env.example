# ============================================================================
# 部署契约 (Deployment contract) — V2026-11-03 治本 (WP25 · Phase1 封版审查)
# ----------------------------------------------------------------------------
# 本文件是**部署契约**: 运维 / 内测操作者唯一能看到的"这个服务能配什么"的清单.
#
#   · **生效行** (=KEY=)  ↔  代码里真实读取的一个 env 键, **一一对应**;
#   · **注释行**            = 说明 / 预留键 (当前代码未接线), 不构成契约.
#   · 文件底部的「预留键 (读得到但未消费)」区 = 代码**读得到**, 但没有任何地方消费 ——
#     配了也不生效, 照抄它们**不会改变任何行为** (位置即语义, 别当成生效项).
#
#   为什么用机器守住 (而不是靠人记得同步):
#     两头漂移的代价不对称, 且**都不报错**:
#       · 漏键 (代码读, 模板没有) → 部署时配不上, 功能默默用默认值;
#       · 多键 (模板有, 代码不读) → 改了半天不生效, 排查成本极高.
#     守卫: test/config/wp25-env-example-coverage.spec.ts (双向断言, 违反即测试变红).
#     **改这个文件后请跑那条测试.**
#
#   值的三种写法:
#     · 密钥 / 密码 / token → 留空 (空 = 代码走"未配置"分支, 由代码自己 fail-fast 或告警)
#     · 数值 → 填**代码里的默认值** (照抄即可得到与代码一致的行为).
#       少数几处**故意不等**代码缺省 (各自的注释里写了为什么) —— 因为"照抄模板"
#       不等于"不配", 差在哪必须写清楚, 否则行为差异从哪来没人说得清.
#     · 开关 (xxx_ENABLED) → true / false
#     · **可选覆盖类**键 → 留空 = 继承代码里的默认值 (真相源在代码里, 模板不重复数值;
#       重复一份就多一个会漂移的真相源 —— 内核常量改了而模板没改时, 显式值会盖掉新常量)
# ============================================================================

# ===== 运行模式与端口 =====
# ⚠️ NODE_ENV 必须保持**注释**状态: 本地照抄本文件不能开 production 模式.
#    生产请在部署环境单独注入 NODE_ENV=production.
# NODE_ENV=development
# 服务监听端口 (默认 3000).
PORT=3000
# Swagger 独立进程端口 (默认 8000; 只在单独起 swagger.ts 时用).
SWAGGER_PORT=8000
# 容器时区 (影响"当日 token 预算"的自然日边界 + 统计口径). 缺省 = UTC.
TZ=Asia/Shanghai
# 允许的跨域来源 (逗号分隔). 生产**必须**显式列举 —— 留空 = 只允许同源.
#   dev 缺省是 '*'; 生产缺省是 '' (不放行任何跨域).
CORS_ORIGINS=
# express-session 密钥.
#   ⚠️ 生产**必须**配: 不配时服务端会生成一个随机密钥并打 error 日志
#      (每次重启都变, 已登录的会话全部失效). 这套 session 只服务已弃用的
#      /auth/* passport demo —— 正式鉴权全走 JWT.
SESSION_SECRET=

# ===== 数据库 (MySQL) =====
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ===== Redis (JWT 黑名单 / BullMQ 队列 / 验证码 / 限流 / 缓存) =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# key 前缀 (多环境隔离用).
REDIS_KEY_PREFIX=mofang

# ===== JWT 密钥 =====
# V1.0 dev 用这个固定值 (生产必须换长随机串)
JWT_SECRET=xin-su-dev-secret-change-in-production-please-use-32-bytes-random
JWT_REFRESH_SECRET=xin-su-dev-refresh-secret-change-in-production-32-bytes-random
# 有效期 (支持 900 / 7d / 12h 这类写法). 缺省: access 15min / refresh 7d.
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ===== SMTP 邮件服务 (复用 mofang-nestjs 现有 shared EmailService) =====
# dev 模式 EMAIL_ENABLED=false 时, 验证码只走 Logger 不发邮件
# 生产必须 EMAIL_ENABLED=true 配置真 SMTP
#
# Gmail 例子:
#   1. https://myaccount.google.com/apppasswords 开启 2FA + 生成应用密码
#   2. EMAIL_USER=your.email@gmail.com
#   3. EMAIL_PASS=xxxx-xxxx-xxxx-xxxx  (16 位应用密码)
#
# 网易 163 例子 (推荐国内 dev):
#   EMAIL_HOST=smtp.163.com
#   EMAIL_PORT=465
#   EMAIL_USER=你的163账号@163.com
#   EMAIL_PASS=16位授权码 (设置 → POP3/SMTP/IMAP → 客户端授权码)
#
# Mailtrap 例子 (dev 推荐 — 不真发, 沙盒看 Inbox):
#   EMAIL_HOST=sandbox.smtp.mailtrap.io
#   EMAIL_PORT=2525
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=心塑
# 邮箱验证 token 有效期 (分钟, 默认 30).
EMAIL_TOKEN_TTL_MIN=30

# ===== 短信 (验证码通道) =====
# provider: mock | aliyun | tencent | twilio (缺省 mock —— 不真发).
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=Mofang
SMS_TEMPLATE_CODE=
SMS_REGION=
# 验证码有效期 (分钟, 默认 5) / 位数 (默认 6) / 单手机号每小时上限 (默认 10).
SMS_CODE_TTL_MIN=5
SMS_CODE_LENGTH=6
SMS_RATE_LIMIT_PER_HOUR=10

# ===== OAuth 第三方登录 =====
# 三个 provider 都是"关 = 不启用"; 开启时对应的 *_APP_ID / *_APP_SECRET 必填.
WECHAT_OAUTH_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=http://localhost:3000/user/oauth/wechat/callback
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/user/oauth/google/callback
APPLE_OAUTH_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM 字符串 (Apple 的 .p8 内容).
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://mofang.cloud/user/oauth/apple/callback

# ===== 密码策略 (大厂生产标准, NIST 800-63B + 国内合规) =====
# 不允许复用最近 N 次 / 强制重置周期 (天) / 改密最小间隔 (分钟) /
# 失败锁定阈值 / 锁定时长 (分钟).
PASSWORD_HISTORY_LIMIT=5
PASSWORD_RESET_CYCLE_DAYS=90
PASSWORD_MIN_AGE_MINUTES=0
PASSWORD_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=30
# 密码重置 token 有效期 (分钟, 默认 60).
PASSWORD_RESET_TOKEN_TTL_MIN=60

# ===== Soft delete (GDPR 合规) =====
# 软删保留天数 + 清理 cron.
SOFT_DELETE_RETENTION_DAYS=30
SOFT_DELETE_CRON=0 3 * * *

# ===== 合规 / 可观测 =====
# 同意记录版本号: 升级此版本号 → 强制客户端重弹同意 dialog (后端权威).
CONSENT_CURRENT_VERSION=v1.0
# Prometheus 指标端点. ⚠️ WP26 P2-3 已加鉴权: 生产**默认关闭** + 开启必须带凭据.
# METRICS_ENABLED: 留空 = 按环境判定 (production → 关; 开发/测试 → 开, 本地调试方便).
#   显式填值时只有 'true' 算开 (写错 env 不会把对外端点打开).
# METRICS_TOKEN: 抓取端点的独立 token (Bearer). **开启 /metrics 时必填** ——
#   没配 = 拒绝一切请求 (fail-close: 配错等于关掉, 不是放开).
#   Prometheus 侧配 authorization.credentials / bearer_token_file; 手工排查可用 x-metrics-token 头.
METRICS_ENABLED=
METRICS_TOKEN=
METRICS_PATH=/metrics
# Sentry (不配 DSN = 关闭上报).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# 线上发布标识 (Sentry release tag).
SENTRY_RELEASE=
# 采样率 (0-1).
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# ===== LLM 路由 (V6.0 §3 + §3.5) =====
# 服务端不内置 default api key (强制每用户在 ai-engine DB 配自己的 key;
# db > env > code 优先级, 详见 src/llm/registry/llm-router.service.ts).
#
# 至少配置 1 个 provider 的 api key, 否则 /v1/chat/completions 返回 503.
#
# ⚠️ 键名规律: LLM_<厂商大写>_API_KEY (OPENAI / DEEPSEEK / DOUBAO / QWEN / CUSTOM).
#    MiniMax 是**例外** —— 它走历史命名 MINIMAX_API_KEY (见下方 MiniMax 段),
#    刻意不改名 (改名会断掉已跑通的语音链路).
LLM_DEEPSEEK_API_KEY=
LLM_DOUBAO_API_KEY=
LLM_QWEN_API_KEY=
LLM_OPENAI_API_KEY=
LLM_CUSTOM_API_KEY=
# 默认 chat / embedding provider (openai / deepseek / doubao / qwen / custom / minimax).
#   代码缺省 (env 未设时): chat = deepseek, embedding = qwen
#   (src/llm/registry/llm-router.service.ts:71-72).
#   ⚠️ 这里 embedding 显式钉 **openai**, 不是代码缺省的 qwen —— 因为知识库默认用
#      EMBEDDING_MODEL=text-embedding-3-small (openai 的模型), 配 openai 才成对.
#      注意知识库发布路径另有一处**独立缺省** openai
#      (src/knowledge-base/providers/knowledge.service.ts:377) —— 两处缺省本来就不一致,
#      这里用显式值消除歧义 (照抄模板 = 走 openai).
LLM_DEFAULT_CHAT_PROVIDER=deepseek
LLM_DEFAULT_EMBEDDING_PROVIDER=openai

# ===== MiniMax 文本模型 (V1.2 VS-A — 督导反馈真接 LLM) =====
# counselor 端 (咨询师学员端) 的 LLM 分析链路 (督导反馈 / 知情同意判定 / 实时轻提示 /
# 技术统计 / 档案抽取) 走 MiniMax 栈 (src/agent/llm/llm.service.ts, OpenAI 兼容协议).
#
# 生效模型优先级: MINIMAX_COUNSELOR_LLM_MODEL > MINIMAX_LLM_MODEL > 代码默认.
# 代码缺省 = MiniMax-M3 (src/config/envs/default.ts:144); 这里显式钉 **MiniMax-M3.1-Flash**
#   (1M 上下文, 思考深度可调, 大炮 2026-10-21 拍板) —— 换回 M3 时下面两行要一起改.
#
# 为什么要独立一个 counselor 变量而不是只改 MINIMAX_LLM_MODEL:
#   1) MINIMAX_LLM_MODEL 是 visitor / supervisor / llm.controller / counselor 全局共用的值;
#   2) counselor 分析链路对输出稳定性 / token 预算的要求跟对话链路不同, 需要独立旋钮.
#
# 注意 1: 思考深度 reasoning_effort 仅 M3.1-Flash 生效, 换成 M3 时会被自动忽略
#         (见 src/counselor/config/counselor-llm.config.ts 的 supportsReasoningEffort).
# 注意 2: M3.1-Flash 会忽略 temperature / top_p (固定 1 / 0.95), 确定性靠 prompt 约束.
# 注意 3: 若 MINIMAX_BASE_URL 指向的域名未开通 M3.1-Flash, 上游会返 404/400,
#         把两个模型变量都改成 MiniMax-M3 即可.
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_API_KEY=
MINIMAX_LLM_MODEL=MiniMax-M3.1-Flash
MINIMAX_COUNSELOR_LLM_MODEL=MiniMax-M3.1-Flash
# 超时 60s: 代码缺省是 30s (default.ts:145), 这里显式放宽到 60s ——
#   M3.1-Flash 强制 adaptive thinking (思考 token 计入输出上限), 首 token 延迟高于 M3;
#   换回 MiniMax-M3 时可以降回 30s.
# 重试 2 次 = 合计 3 次尝试 (首次 + 2 次重试; 代码缺省也是 2, default.ts:146).
#   退避 200ms / 600ms / 1.4s (llm.service.ts 的指数退避).
MINIMAX_LLM_TIMEOUT_MS=60000
MINIMAX_LLM_MAX_RETRIES=2

# ===== MiniMax 语音转写 (STT) — V2026-10-23 语音微训练 STT 代理 =====
# STT 复用上面的全局 MINIMAX_BASE_URL / MINIMAX_API_KEY (同一个上游, 不另开配置位).
#   国内: https://api.minimax.cn    国际: https://api.minimax.io
# key 类型不写死: 按量 API Key 与 M Plan 订阅 Key 都可填, 由部署环境按实际账户决定.
# 转写超时 (与 LLM 超时隔离) / 本地体积与时长上限 (默认与上游一致)
MINIMAX_ASR_TIMEOUT_MS=30000
MINIMAX_ASR_MAX_FILE_BYTES=52428800
MINIMAX_ASR_MAX_DURATION_SEC=500
# STT 代理签发的客户端 token: 密钥 + 有效期 (秒). 客户端直连上游时用.
MINIMAX_ASR_TOKEN_SECRET=
MINIMAX_ASR_TOKEN_TTL_SEC=300
# 端点级限流: 单用户每分钟转写次数 (按 userId, 不按 IP) + 限流窗口 (毫秒).
PRACTICE_ASR_RATE_LIMIT_PER_MINUTE=10
PRACTICE_ASR_RATE_LIMIT_WINDOW_MS=60000

# ===== MiniMax 语音合成 (TTS) 双向流式 — V2026-10-23 全真会谈逐句出声 =====
# 协议: wss://api.minimax.cn/ws/v1/t2a_v2_bidi (官方 T2A V2)
#   - 纯 JSON 文本帧, 帧类型字段是 `event`; 音频在 task_continued.data.audio (hex mp3 分片)
#   - 后端按句攒齐 mp3 再下发 (前端播完整句, web/native 双端兼容)
#   - 完整规格: docs/specs/counselor-roleplay-voice-bidi-tts-2026-10-23.md
# 复用上面的全局 MINIMAX_BASE_URL / MINIMAX_API_KEY (同一个上游, 不另开 key).
#
# 模型: 官方枚举只有 turbo / hd 后缀, `speech-2.8` (无后缀) **不存在**, 用了必被 2013 拒.
MINIMAX_TTS_MODEL=speech-2.8-turbo
# 音色 (voice_id): 必填, 从官方「系统音色列表」选一个自然中文女声填入 (调试台试听确认).
#   本项目**不给默认值** —— 未核实的占位音色会合成出"能播但不像人"的音频, 排查成本高.
#   未配置时: voice 模式回 error(tts_config_invalid); text 模式不受影响.
#   官方文档里公开给出的中文音色 id (可直接复制, 最终选哪个以试听为准):
#     Chinese (Mandarin)_Lyrical_Voice
#     Chinese (Mandarin)_HK_Flight_Attendant
MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Lyrical_Voice
# 语言增强 (官方枚举: Chinese / English 等).
MINIMAX_TTS_LANGUAGE_BOOST=Chinese
# 语速 / 音量 / 音调 (官方值域: speed 0.5-2 / vol 0-10 / pitch -12~12)
MINIMAX_TTS_SPEED=1
MINIMAX_TTS_VOLUME=1
MINIMAX_TTS_PITCH=0
# 音频参数: mp3 / 32000Hz / 单声道
MINIMAX_TTS_SAMPLE_RATE=32000
MINIMAX_TTS_BITRATE=128000
# 建连 + 握手超时 (等 connected_success / task_started)
MINIMAX_TTS_TIMEOUT_MS=30000
# 单句最大字符数 (超长句强制切; 兼作上游 2204 的本地防线)
MINIMAX_TTS_MAX_SENTENCE_CHARS=100
# 保活 ping 间隔 (官方不主动 ping, 120s 空闲会以 2201 断开); 0 = 关闭
MINIMAX_TTS_KEEPALIVE_MS=30000
# 连接池: 并发上限 (跟 MiniMax 单账号并发限制对齐) + acquire 排队超时
MINIMAX_TTS_MAX_CONNECTIONS=100
MINIMAX_TTS_ACQUIRE_TIMEOUT_MS=10000
# 官方音色目录代理: 查询超时 / 握手里建议性校验超时 / 内存缓存 TTL (毫秒).
MINIMAX_VOICES_TIMEOUT_MS=15000
MINIMAX_VOICES_CHECK_TIMEOUT_MS=3000
MINIMAX_VOICES_CACHE_TTL_MS=600000

# ===== Embedding 服务 (Phase 6 接入) =====
#   - provider 切换不改 schema (bge / chatanywhere 都是 1024 维)
#   - 用户已提供 2 个 chatanywhere key, 通过 EMBEDDING_API_KEY / EMBEDDING_API_KEY_MPLAN env 注入
#   - bge 自托管 URL 走容器内网, 生产推荐
EMBEDDING_PROVIDER_DEV=chatanywhere
EMBEDDING_PROVIDER_PROD=bge_large_zh
EMBEDDING_API_KEY=
EMBEDDING_API_KEY_MPLAN=
EMBEDDING_BGE_URL=http://bge-embedding.internal:8080
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024

# ===== Qdrant 向量库 (V6.0 §12 RAG) =====
# docker run -p 6333:6333 -v /tmp/qdrant_storage:/qdrant/storage qdrant/qdrant
# 生产环境推荐启用 QDRANT_API_KEY (Qdrant 1.x 支持鉴权).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# 知识库检索 / 发布用的集合 (ai-engine + knowledge-base 侧, 代码缺省同名).
# ⚠️ 引擎记忆仓储**不用**它 —— 记忆仓储用的是代码常量 visitor_long_memory
#    (与知识库刻意隔离: 公共科普内容不能混进来访者私有长时记忆).
QDRANT_KB_COLLECTION=knowledge_chunks
# 知识库向量检索开关 (false = 只走 LIKE 软降级).
KB_VECTOR_SEARCH_ENABLED=true

# ===== RAG 切块 (V2026-10-15 治本 · VS-3 续) =====
#   RAG_AUTO_EMBED: publish 成功时是否自动向量化写 Qdrant (默认 true). 设 false 走
#     V0.x 行为 (search 走 LIKE 软降级).
#   RAG_CHUNK_SIZE / RAG_CHUNK_OVERLAP: LangChain RecursiveCharacterTextSplitter 参数,
#     默认 200 / 20 (1 KB 文档约 5 chunk).
#   LLM_DEFAULT_EMBEDDING_PROVIDER: 走 OpenAI 兼容 4 provider 之一, 与上面的
#     LLM_DEFAULT_EMBEDDING_PROVIDER 是同一个键 (embedding 专用口径).
RAG_AUTO_EMBED=true
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=20

# ===== PsyGUARD 风险探测服务 (V2026-10-30 · WP11) =====
# 独立仓库 mofang-psyguard 的 PsyGUARD-RoBERTa 中文危机风险分类服务 (FastAPI + ONNX Runtime).
#
# 留空 = **不启用** (行为与现状逐字一致: 用本地规则探测器 LocalCrisisProbe).
# 配了 = 改用 HTTP 探测器打这个地址; 服务不可达/超时/503 一律静默回落本地规则, 不阻断对话.
#
# 生产部署 (同机 host 网络): 只绑 127.0.0.1, 不对外暴露.
#   docker compose up -d   (在 /opt/mofang-psyguard)
#   PSYGUARD_BASE_URL=http://127.0.0.1:8100
#
# ⚠️ 探测预算: 内核 assessSafety 的探测超时是**硬上限** (engine-core 红线, 适配层改不动),
#    服务必须在该上限内答完 —— 否则探测恒定回落本地规则 (服务在跑但等于没接).
#    正式口径 150ms —— **真相源是内核常量 `DEFAULT_PROBE_TIMEOUT_MS`**
#    (src/engine-core/cognition/safety/assess-safety.ts);
#    服务侧对应的 token 窗口 (兄弟仓 mofang-psyguard 的 PSYG_MAX_LENGTH) 是 28.
#
#    下面那个超时 env **故意不写数值**: 模板里写死一份 = 多一份会漂移的真相源.
#    内核常量改了而模板没改 → 显式配置值会**盖掉**新常量 (env 优先于代码缺省),
#    于是出现"内核等 150ms、HTTP 还在等 500ms"这种自相矛盾的口径.
#    真相源只留一个 (内核常量), 模板不重复它 —— 留空 = 用内核常量的 150ms.
#
# ⚠️ PSYGUARD_TIMEOUT_MS 是**可选覆盖**, 一般不用配:
#    只有在**服务侧 token 窗口同步放宽**时才需要动它 —— 单独调大会让 HTTP 等得比内核久,
#    出现"内核已回落规则、HTTP 连接还在后台跑完"的浪费 (内核不取消探测).
#
# ⚠️ **生产机 .env 里如果还留着旧的 500, 它会盖掉内核常量** —— 模板改了不等于线上改了:
#    上线前核对 /opt/mofang-nestjs/.env 的这个键 (不设最好: 不设就继承内核常量).
#
#    历史 (WP11 审核后决策 #4): 测试阶段只有一个人用, 准确率优先于延迟 →
#    曾把超时与内核常量一起放宽到 500, 同时把服务侧 token 窗口从 28 放宽到 256.
#    WP28 (2026-11-03) 已两侧一起改回 (超时 150ms / 窗口 28).
PSYGUARD_BASE_URL=
PSYGUARD_TIMEOUT_MS=

# ===== 记忆衰减 / 召回配置 (V2026-10-30 · WP12) =====
# 长时记忆的"重要度衰减"与"召回门槛"两个工程种子值 —— 集中在一处配置, 不散落.
#
# MEMORY_DECAY_HALF_LIFE_DAYS: 重要度衰减半衰期 (天). 默认 30 (与内核常量同值).
#   越小 = 旧记忆淡出越快 (学员回来时引擎想不起上次); 越大 = 记得越久.
# MEMORY_RECALL_THRESHOLD: 访客范围召回的有效重要度门槛 [0,1]. 默认 0.1 (与内核常量同值).
#   越大 = 只召回"更重要"的记忆 (噪音少, 但可能想不起来).
#
# ⚠️ 这两个值**只对 Qdrant 版记忆仓储生效** (纯内存版的召回判定在内核里).
# ⚠️ 内核那道地板改不动 (WP12 红线: 不改 src/engine-core/**), 所以阈值**只能收紧**:
#    配成 < 0.1 不会让内核放行 (内核仍按 0.1 卡一道), 配成 > 0.1 会在 B 层额外加一道.
#    非法值 (非数字 / ≤0 / >1) 一律回退默认值, 不抛错 —— 填错 env 不该让服务起不来.
#
# ⚠️ 这两个值是**工程种子值, 未标定** —— 后期靠真实训练数据校准, 不是临床结论.
MEMORY_DECAY_HALF_LIFE_DAYS=30
MEMORY_RECALL_THRESHOLD=0.1

# 会话摘要用的模型名 (收尾时把本场逐字稿压成 ≤200 字摘要, 再晋升为长时记忆).
# 留空 = 用 LLM 路由的 RAG 分层默认模型 (各家厂商的模型名只有路由知道, 这里不硬编码).
# 配错 = 摘要生成失败 → 记 warn, 本场不晋升长时记忆 (不影响会话正常结束).
# ⚠️ WP37 起, 同一族任务 (会话摘要) 共用这一个键: 滚动摘要 (会话中段) 与最终摘要
#    (会话结束) 都是"从长文本抽要点", 用两个键就会出现"两个真相源".
MEMORY_SUMMARY_MODEL=

# ----- 会话摘要参数 (WP37 · 3 个键) -----
# SESSION_SUMMARY_BATCH_SIZE: 滚动摘要的**攒批阈值** —— 攒够 N 轮被工作窗口淘汰的
#   对话才压一次摘要. 默认 3 (≈ 每 3 轮一次 LLM 调用).
#   ⚠️ WP55 起单位是"轮问答对" (一轮 = 一次咨询师发言 + 一次来访者回复),
#     不是"条咨询师发言" —— 口径更清晰, 数量不变.
#   越小 = 摘要更及时但 LLM 调用更密 (30 轮对话 ≈ 22 轮被淘汰);
#   越大 = 调用更省, 但"刚被挤掉的那几轮"要等更久才被压进去.
# SESSION_SUMMARY_ROLLING_IMPORTANCE: 滚动摘要的重要度 [0,1]. 默认 0.5.
#   滚动摘要是**会话中段**的上下文, 不是跨会话的核心事实 —— 比长期记忆 (0.9) 轻.
# SESSION_SUMMARY_FINAL_IMPORTANCE: 会话结束的最终摘要重要度 [0,1]. 默认 0.9.
#   取 0.9 的理由: 长时记忆召回按**衰减后**的有效重要度卡 0.5 门槛 (半衰期 30 天),
#   0.9 → 衰减到 0.5 约需 23 天, 也就是"学员一周后回来还能被想起".
# ⚠️ 三个值都是**工程种子值, 未标定** —— 待真实对练校准.
# ⚠️ 非法值 (空串 / 非数字 / 攒批阈值 < 1 / 重要度不在 [0,1]) 一律回退种子值, 不抛错.
# ⚠️ 这些键由**适配层**读取 (src/engine-adapters/wiring/session-summary.config.ts),
#   内核**零 env 读取**.
SESSION_SUMMARY_BATCH_SIZE=
SESSION_SUMMARY_ROLLING_IMPORTANCE=
SESSION_SUMMARY_FINAL_IMPORTANCE=

# ===== 单场成本日志 (V2026-10-30 · WP24) =====
# 内测期防烧 LLM 额度用: 每场会话结束打一条 `session_cost_summary` 结构化日志,
# 里面有本场总 token 与预估费用. 定价做成 env 是因为**厂商调价是外部事实** ——
# 写死在代码里意味着每次调价都要发一次版.
#
# 单位: 元 / 千 token (不是元 / token, 也不是元 / 百万 token).
# 公式: estimatedCostCny = (totalPromptTokens/1000)*输入价 + (totalCompletionTokens/1000)*输出价
#
# ⚠️ **输入侧用量在流式路径不可得** (上游只给累计 tokenCount, 没有 prompt/completion
#    拆分) —— 这时成本口径会如实落成 `costBasis: "output_only"`, 即**只含输出侧**,
#    是全场成本的下界. 读日志时先看 costBasis,  别把它当全场成本.
#
# ⚠️ 这两个值是**工程默认值**, 不是与厂商合同核对过的报价 —— 真正计费以厂商账单为准.
#    非法值 (空串 / 非数字 / 负数) 一律回退默认值, 不抛错 —— 填错 env 不该让服务起不来.
LLM_PRICE_INPUT_PER_1K=0.0015
LLM_PRICE_OUTPUT_PER_1K=0.0045

# ===== 督导报告 (V2026-10-26 / WP21) =====
# 主报告是**异步**生成的 (BullMQ + LLM). 这些是"陈旧 pending"判定与 SSE 推送的参数.
#   缺省值在 counselor/config/supervision.config.ts (单一真值源), 这里只声明"本地怎么跑"的可调项.
SUPERVISION_REPORT_PENDING_TIMEOUT_MS=300000
SUPERVISION_MIN_EFFECTIVE_TURNS=3
SUPERVISION_MIN_EFFECTIVE_CHARS=200
SUPERVISION_REPORT_STREAM_POLL_INTERVAL_MS=2000
SUPERVISION_REPORT_STREAM_TIMEOUT_MS=120000

# ===== 督导主报告 LLM 参数 (agent/supervisor) =====
# 主报告的思考深度 / 生成长度上限 / 超时窗口.
#   思考深度合法档位: low / medium / high / xhigh / max (非法 → 回落 high).
#   数值非法或非正 → 回退缺省值.
ENGINE_SUPERVISION_REASONING_EFFORT=high
ENGINE_SUPERVISION_MAX_TOKENS=8192
ENGINE_SUPERVISION_TIMEOUT_MS=120000

# ===== 练习端 LLM 开关与限额 (counselor) =====
# 两个**语义正交**的开关, 都缺省 on (保持既有行为). 置 off = 不发起任何对应调用:
#   · PRACTICE_LLM_EVALUATION  → §3.3 评判 (evaluateWithLlm); off 时走确定性关键词路径,
#                                 接口形状不变;
#   · PRACTICE_LLM_GENERATION  → P2 来访者反应 + §3.5/§7.2 场景生成; off 时走模板降级.
# ⚠️ 别把 EVALUATION=off 理解成"把练习引擎的 LLM 成本关掉" —— 生成链路照旧烧钱.
PRACTICE_LLM_EVALUATION=on
PRACTICE_LLM_GENERATION=on
# 自定义私有场景: 每用户每天生成次数上限 / 私有场景存量上限 / 生成时限 (毫秒).
#   非法或非正 → 回退缺省值 (5 / 50 / 8000).
PRACTICE_CUSTOM_SCENARIO_DAILY_LIMIT=5
PRACTICE_CUSTOM_SCENARIO_MAX_COUNT=50
PRACTICE_CUSTOM_SCENARIO_GENERATION_TIMEOUT_MS=8000
# 访客人设批量生成条数上限 (env 覆盖, 硬顶 5; 非法或非正 → 回退 1).
VISITOR_POOL_GENERATE_MAX_COUNT=1

# ===== 语音对练 · 断线重连追平 (V2026-11-03 · WP23) =====
# 这两个值服务的是**断线重连**这条路: 客户端重连时带 `lastSeenTurnIndex`,
# 服务端把漏掉的轮次一次性补回去 (`session_catchup` 帧).
#
# ⚠️ VOICE_SESSION_IDLE_TIMEOUT_MINUTES 的语义是"内存卫生兜底", **不是**断连宽限期:
#    断连本身不挂任何定时器 (断线不杀会话, 重连即补漏); 这个计时器只管
#    "从最后一次收到客户端消息算起, 多久没人理就主动收尾" —— 一场没人理的对练
#    不该在内存里挂两小时.
#    单位: **分钟** (不是毫秒).
# ⚠️ 非法值 (非数字 / 0 / 负数) 一律回退默认值, 不照用 ——
#    0 会让兜底立刻触发 (会话秒死), 非法值会让兜底形同虚设.
VOICE_SESSION_IDLE_TIMEOUT_MINUTES=120
# 重连时最多补几轮. 漏的轮次超过它就不补 (推 `session_stale`, reason=too_far_behind),
# 让客户端自己从头开始 —— 一次塞两百条历史既塞不进 UI, 也让"补漏"变成"灌数据".
# ⚠️ 非法值 (非数字 / 0 / 负数) 一律回退默认值 20.
VOICE_CATCHUP_MAX_TURNS=20
# (VOICE_SESSION_IDLE_TIMEOUT_MS 这个毫秒版遗留键已移到文件底部「预留键」区 ——
#  代码读得到它, 但没有任何地方消费它, 配了不生效.)

# ===== 语音对练 · 限流与灰度 (WP22 / WP8-B) =====
# 全局**当日** completion token 预算 (0 = 不限制). 内测期防"bug 循环 / 恶意刷"烧额度.
VOICE_DAILY_TOKEN_BUDGET=500000
# 单用户并发语音会话上限 (本期恒为 1; 留这个 env 是为了以后放开时不必改代码结构).
VOICE_MAX_CONCURRENT_PER_USER=1
# 灰度开关: 新引擎是否接管语音链路. 缺省 false —— 旧链路 100% 原样, 可一键回退.
ENGINE_VOICE_ENABLED=false
# 灰度会话白名单 (逗号分隔的 sessionId). 空 = 总开关打开即全量.
ENGINE_STREAM_GRAYSCALE_SESSIONS=

# ===== 引擎调试与调参 (WP9-A / WP15 / WP19-R) =====
# 引擎逐轮留痕 (trace) 开关. 缺省关 —— 开了会显著增加落库量.
# ⚠️ 留痕是"BDI 快照可还原"的前提 (WP19-R): 进程重启后想还原上一场会话的
#    BDI 状态, 依赖这份逐轮 trace. 生产关着 = 重启后还原不了.
ENGINE_DEBUG_TRACE_ENABLED=false
# 引擎调试面板写接口 (WP58) 开关. 缺省: 非生产开 / 生产关.
# ⚠️ 这三个接口**能真跑引擎** (每轮一次 LLM 调用) —— 生产环境缺省必须关.
#   开了就等于让持有 admin 凭据的人反复烧额度, 且调试会话会占住内核会话与记忆仓储.
ENGINE_DEBUG_CHAT_ENABLED=false
# 等审议 trace 的上限 (毫秒). 缺省 5000.
#   影子审议是异步跑的 (BullMQ → Worker → LLM → 写 Redis), turn 返回时 trace
#   通常还没落地 —— 不等就必然读到 null. 0 = 不等 (直接读一次).
ENGINE_DEBUG_CHAT_DELIBERATION_WAIT_MS=
# 调试会话持久化目录 (2026-11-05 四合一任务单). 缺省 data/debug-sessions.
#   调试会话**每轮追加写** JSON 文件到这里 —— 刷新 / 进程重启不丢数据.
#   同目录会保留最近 50 个会话 (超出按创建时间淘汰).
# ⚠️ 这里面是**心理内容** (来访者逐字稿 + prompt 全文) —— 必须放在不进版本库的位置
#    (仓库已把默认路径写进 .gitignore); 生产建议挂独立卷.
ADMIN_DEBUG_SESSION_DIR=data/debug-sessions
# 角色数据源: db (缺省, MySQL 角色池) | builtin (回退/测试档).
ENGINE_CHARACTER_SOURCE=db

# ----- 单回合非对称 delta cap (WP15 · 11 维 × 2 方向 = 22 个键) -----
# 键名: ENGINE_CAP_<维度>_UP / ENGINE_CAP_<维度>_DOWN.
#   维度: TRUST / SAFETY / BOND / VALENCE / AROUSAL / VERBAL / DEPTH / STYLE / POSITIVE / NEGATIVE / DEPENDENCY.
#   (SAFETY / BOND 是 WP42 的咨询同盟三维新增维度.)
# 语义: 一回合内 BDI 各维度的**最大变动幅度** (正 delta 砍到上向, 负 delta 砍到下向).
#   信任 / 情绪效价 / 安全感 / 纽带感: 上 +0.20 / 下 -0.30 (损失厌恶 —— 建得慢、破得快)
#   唤醒度 / 阻抗三维: ±0.20 (对称)
#   移情三维:          ±0.15 (移情涨得慢)
# ⚠️ 非法值 (空串 / 非数字 / 符号与方向不符) 一律回退种子值 —— 配错一个 env
#    不该让整场对练的 BDI 迁移失真.
# ⚠️ 这些键由**适配层**读取 (src/engine-adapters/wiring/delta-cap.config.ts),
#    装配成内核的 DeltaCapConfig 端口 —— 内核**零 env 读取** (WP26 P2-14 已改,
#    有机器断言守着: 内核树里不许出现任何 ENGINE_CAP_* 字符串).
#    但它们仍是**进程级配置**: 同一 seed + 同一行为序列, 在不同 cap 配置下会落到
#    不同状态 (回放不可跨环境对拍) —— env 不进内核, 不等于 env 不影响决策.
#
# ⚠ 这 18 行**故意不写数值**: 真相源只留一个 (内核种子值 DEFAULT_DELTA_CAP_CONFIG),
#    模板里再写一份 = 多一份会漂移的真相源. 内核改了种子而模板没改 → 显式值会
#    **盖掉**新种子 (env 优先于代码缺省), 于是出现"内核按 0.15 砍、线上还按 0.20 砍".
#    留空 = 用内核种子的值; 要校准时才填数字.
ENGINE_CAP_TRUST_UP=
ENGINE_CAP_TRUST_DOWN=
ENGINE_CAP_SAFETY_UP=
ENGINE_CAP_SAFETY_DOWN=
ENGINE_CAP_BOND_UP=
ENGINE_CAP_BOND_DOWN=
ENGINE_CAP_VALENCE_UP=
ENGINE_CAP_VALENCE_DOWN=
ENGINE_CAP_AROUSAL_UP=
ENGINE_CAP_AROUSAL_DOWN=
ENGINE_CAP_VERBAL_UP=
ENGINE_CAP_VERBAL_DOWN=
ENGINE_CAP_DEPTH_UP=
ENGINE_CAP_DEPTH_DOWN=
ENGINE_CAP_STYLE_UP=
ENGINE_CAP_STYLE_DOWN=
ENGINE_CAP_POSITIVE_UP=
ENGINE_CAP_POSITIVE_DOWN=
ENGINE_CAP_NEGATIVE_UP=
ENGINE_CAP_NEGATIVE_DOWN=
ENGINE_CAP_DEPENDENCY_UP=
ENGINE_CAP_DEPENDENCY_DOWN=

# ----- P1 人格调节系数 (WP34 · 4 依恋类型 × 2 系数 + 宜人性 2 项 = 10 个键) -----
#   + WP53 扩展 (4 依恋类型 × 2 同盟系数 = 8 个键) → 本段共 18 个键.
# 键名: ENGINE_MOD_<依恋类型>_<TRUST|RESIST|SAFETY|BOND>_SCALE
#   依恋类型大写: SECURE / AVOIDANT / ANXIOUS / DISORGANIZED;
#   宜人性两项: ENGINE_MOD_AGREEABLENESS_TRUST_SCALE / ENGINE_MOD_AGREEABLENESS_HIGH_THRESHOLD.
# 语义: 依恋类型调节**信任增益**与**阻抗下降**的速度 —— 同样一句共情, 安全型信任涨得快,
#   回避型涨得慢 (阻抗也降得少 = 不快速敞开心扉), 焦虑型反之.
#   TRUST 系数只作用于信任**增益**方向, RESIST 系数是阻抗**水平**倍率 (阻抗下降量 ÷ 它).
#   SAFETY / BOND (WP53) 作用于同盟三维的**增益**方向 —— 回避型安全感与纽带感都涨得慢,
#   焦虑型安全感涨得慢但纽带涨得快. 受损方向一律不调.
# ⚠️ 系数是**工程种子值, 非临床标定** —— 待真实对练校准.
# ⚠️ 这 18 行**故意留空**: 真相源只留一个 (内核种子值 DEFAULT_PERSONALITY_MODULATOR_CONFIG),
#   模板里再写一份数值 = 多一份会漂移的真相源 (内核改了模板没改 → 显式值会盖掉新种子).
#   留空 = 用内核种子值; 要校准时才填数字.
# ⚠️ 非法值 (空串 / 非数字 / 增益系数为负 / 阻抗为 0 或负 / 阈值不在 [0,1]) 一律回退种子值.
# ⚠️ 这些键由**适配层**读取 (src/engine-adapters/wiring/personality-modulator.config.ts),
#   装配成内核的 PersonalityModulatorConfig 端口 —— 内核**零 env 读取**.
ENGINE_MOD_SECURE_TRUST_SCALE=
ENGINE_MOD_SECURE_RESIST_SCALE=
ENGINE_MOD_SECURE_SAFETY_SCALE=
ENGINE_MOD_SECURE_BOND_SCALE=
ENGINE_MOD_AVOIDANT_TRUST_SCALE=
ENGINE_MOD_AVOIDANT_RESIST_SCALE=
ENGINE_MOD_AVOIDANT_SAFETY_SCALE=
ENGINE_MOD_AVOIDANT_BOND_SCALE=
ENGINE_MOD_ANXIOUS_TRUST_SCALE=
ENGINE_MOD_ANXIOUS_RESIST_SCALE=
ENGINE_MOD_ANXIOUS_SAFETY_SCALE=
ENGINE_MOD_ANXIOUS_BOND_SCALE=
ENGINE_MOD_DISORGANIZED_TRUST_SCALE=
ENGINE_MOD_DISORGANIZED_RESIST_SCALE=
ENGINE_MOD_DISORGANIZED_SAFETY_SCALE=
ENGINE_MOD_DISORGANIZED_BOND_SCALE=
ENGINE_MOD_AGREEABLENESS_TRUST_SCALE=
ENGINE_MOD_AGREEABLENESS_HIGH_THRESHOLD=

# ----- 咨询同盟三维系数与门槛 (WP42 · 11 种事件 × 2 维 + 3 个门槛 = 25 个键) -----
# 键名: ENGINE_ALLIANCE_<事件>_SAFETY / ENGINE_ALLIANCE_<事件>_BOND
#   事件大写: EMPATHY / ACCEPTANCE / NORMALIZATION / OPEN_PROBE / AFFIRMATION /
#             JUDGMENT / PREACHING / MINIMIZING / BOUNDARY_CROSS / SENSITIVE_TOUCH / NEUTRAL.
#   门槛三项: ENGINE_ALLIANCE_OPEN_THRESHOLD /
#             ENGINE_ALLIANCE_RESIST_TRUST_THRESHOLD /
#             ENGINE_ALLIANCE_RESIST_SAFETY_THRESHOLD.
# 语义: 覆写"某一类咨询师行为"对**安全感 / 纽带感**的单事件增量, 以及意图规划的门槛.
#   · 系数是**工程种子值, 非临床标定** —— 待真实对练校准.
#   · 门槛: 探索要 min(信任, 安全感) >= open; 抗拒要 信任 < resistTrust 或 安全感 < resistSafety.
# ⚠️ 这 25 行**故意留空**: 真相源只留一个 (内核种子值 DELTA_TABLE / DEFAULT_ALLIANCE_CONFIG),
#   模板里再写一份数值 = 多一份会漂移的真相源 (内核改了模板没改 → 显式值会盖掉新种子).
#   留空 = 用内核种子值; 要校准时才填数字.
# ⚠️ 非法值 (空串 / 非数字 / 门槛不在 [0,1]) 一律不覆写 = 回退内核种子值.
# ⚠️ 这些键由**适配层**读取 (src/engine-adapters/wiring/alliance-config.ts),
#   装配成内核的 AllianceConfig 端口 —— 内核**零 env 读取**.
ENGINE_ALLIANCE_EMPATHY_SAFETY=
ENGINE_ALLIANCE_EMPATHY_BOND=
ENGINE_ALLIANCE_ACCEPTANCE_SAFETY=
ENGINE_ALLIANCE_ACCEPTANCE_BOND=
ENGINE_ALLIANCE_NORMALIZATION_SAFETY=
ENGINE_ALLIANCE_NORMALIZATION_BOND=
ENGINE_ALLIANCE_OPEN_PROBE_SAFETY=
ENGINE_ALLIANCE_OPEN_PROBE_BOND=
ENGINE_ALLIANCE_AFFIRMATION_SAFETY=
ENGINE_ALLIANCE_AFFIRMATION_BOND=
ENGINE_ALLIANCE_JUDGMENT_SAFETY=
ENGINE_ALLIANCE_JUDGMENT_BOND=
ENGINE_ALLIANCE_PREACHING_SAFETY=
ENGINE_ALLIANCE_PREACHING_BOND=
ENGINE_ALLIANCE_MINIMIZING_SAFETY=
ENGINE_ALLIANCE_MINIMIZING_BOND=
ENGINE_ALLIANCE_BOUNDARY_CROSS_SAFETY=
ENGINE_ALLIANCE_BOUNDARY_CROSS_BOND=
ENGINE_ALLIANCE_SENSITIVE_TOUCH_SAFETY=
ENGINE_ALLIANCE_SENSITIVE_TOUCH_BOND=
ENGINE_ALLIANCE_NEUTRAL_SAFETY=
ENGINE_ALLIANCE_NEUTRAL_BOND=
ENGINE_ALLIANCE_OPEN_THRESHOLD=
ENGINE_ALLIANCE_RESIST_TRUST_THRESHOLD=
ENGINE_ALLIANCE_RESIST_SAFETY_THRESHOLD=

# ----- 跨会话间隔自然衰减的半衰期 (WP36 · 3 个键) -----
# 键名: ENGINE_DECAY_<组>_HALF_LIFE_MS
#   组: EMOTION (情绪) / RESISTANCE (阻抗) / ALLIANCE (同盟).
# 语义: resume (跨会话接续) 时, 按"距上一场结束的时间间隔"对三类**状态性维度**
#   做差异化半衰期回落 —— 情绪 (valence / arousal) 7 天, 阻抗三维 14 天,
#   同盟三维 (trust / safety / bond) 30 天.
#   核心信念 / 欲望 / 移情**不衰减** (稳定人格特质, 不因隔了几天而改变).
#   衰减恒 > 0 (渐近不归零) —— "关系不会因为一周不见就回到陌生人"在数值上成立.
# ⚠️ 半衰期是**工程种子值, 非临床标定** —— 待真实对练校准.
# ⚠️ 这 3 行**故意留空**: 真相源只留一个 (内核种子值 DEFAULT_SESSION_DECAY_CONFIG),
#   模板里再写一份数值 = 多一份会漂移的真相源 (内核改了模板没改 → 显式值会盖掉新种子).
#   留空 = 用内核种子值; 要校准时才填数字 (单位: 毫秒).
# ⚠️ 非法值 (空串 / 非数字 / ≤0) 一律回退内核种子值 —— 0 会让衰减因子变成 Infinity,
#   负数会让"越久越淡"变成"越久越浓", 两者都会污染整份快照.
# ⚠️ 这些键由**适配层**读取 (src/engine-adapters/wiring/session-decay.config.ts),
#   装配成内核的 SessionDecayConfig 端口 —— 内核**零 env 读取**.
ENGINE_DECAY_EMOTION_HALF_LIFE_MS=
ENGINE_DECAY_RESISTANCE_HALF_LIFE_MS=
ENGINE_DECAY_ALLIANCE_HALF_LIFE_MS=

# ----- BDI 状态持久化 (WP32 · 2 个键) -----
# ENGINE_BDI_STATE_STORE: BDI 状态的存储形态.
#   memory (缺省) = 进程内存 —— 进程重启状态全丢 (与 WP32 之前逐字一致, 零回归);
#   redis          = 落 Redis —— 进程重启后跨会话恢复自动生效.
#   ⚠️ **非法值会在启动期直接炸** (不静默回落成 memory): 静默回落 = 线上以为在持久化,
#      实际一条都没存, 而且不报错 —— 仓库既有装配层铁律.
# ENGINE_BDI_STATE_REDIS_TTL_SECONDS: Redis 版状态的存活时长 (秒). 缺省 604800 (7 天).
#   口径: 只清理"开完就再没回来"的僵尸会话 —— 在用的一场每轮 save 都会续期, 不会中途丢.
#   ⚠️ 非法值 (空串 / 非数字 / ≤0) 一律回退 604800, 不抛错 (只是清理节奏, 不是持久化能力).
# ⚠️ 这 2 行**故意留空**: 真相源只留一个 (代码缺省 = memory / 604800),
#    模板里再写一份数值 = 多一份会漂移的真相源. 留空 = 用代码缺省; 要切 Redis 才把 STORE 填成 redis.
ENGINE_BDI_STATE_STORE=
ENGINE_BDI_STATE_REDIS_TTL_SECONDS=

# ----- LLM 审议层 PoC · 影子模式 (WP64 · 4 个键 + WP65 · 1 个键) -----
# ⚠️ **默认全关**: 影子模式每轮会**多发一次 LLM 请求** (真花钱), 不配就零成本、零行为变化.
#    要跑 PoC 时把 ENGINE_DELIBERATION_ENABLED 打开, 并盯着 token 账单.
# ENGINE_DELIBERATION_ENABLED: 影子审议开关. 缺省 = 关 (false).
#   打开后: 每轮渲染完成后**旁路**跑一次 LLM 审议, 结果**不写进状态** (不生效),
#   只写 Redis trace 表 (key=deliberation_trace:..., TTL 30 天) 供离线对比分析.
#   ⚠️ 它是**旁路**: 不 await, 不影响对练的响应时间; 审议挂了也不会炸主流程.
#   V2026-11-05 (WP65): 开关打开后, 审议请求改走 **BullMQ 队列** (队列名 deliberation-shadow),
#   Worker 按下面的并发数慢慢跑 —— 不再是"每轮直接发一个请求" (那会打爆上游配额).
# ENGINE_DELIBERATION_MODEL: 审议专用模型名. **留空 = 用 counselor 域的默认模型**
#   (env MINIMAX_COUNSELOR_LLM_MODEL → MiniMax-M3.1-Flash).
#   ⚠️ 不要动全局的 MINIMAX_LLM_MODEL / MINIMAX_BASE_URL —— 那是 ASR/TTS 共用的全局值.
# ENGINE_DELIBERATION_TIMEOUT_MS: 单次审议超时 (毫秒). 缺省 3000.
#   ⚠️ 非法值 (空串 / 非数字 / ≤0) 一律回退 3000, 不抛错.
# ENGINE_DELIBERATION_TEMPERATURE: 审议采样温度. 缺省 0.3.
#   ⚠️ M3.1-Flash **忽略** temperature / top_p (官方固定 1 / 0.95) ——
#      这个键只在你把上面的 MODEL 换成别的模型时才真正生效.
#   ⚠️ 非法值 (非数字 / 越界) 一律回退 0.3, 不抛错.
# ENGINE_DELIBERATION_WORKER_CONCURRENCY: 审议 Worker 并发数 (WP65). 缺省 3.
#   审议单次调用 3-8s (推理模型 thinking + 输出), 比督导队列的 30-120s 短, 可以并发.
#   ⚠️ 非法值 (空串 / 非数字 / ≤0) 一律回退 3, 不抛错 (填错一个 env 不该让服务起不来).
# ENGINE_DELIBERATION_MAX_RETRIES: 审议**重试**次数 (WP66). 缺省 1 (总共跑 2 次).
#   只对"值得重试"的失败生效 —— 模型输出形状不对 (JSON 没吐出来 / 形状不符) 或
#   上游限流与 5xx. 鉴权错 / 网络超时 / 代码 bug **不重试** (重试也大概率同样失败).
#   ⚠️ 不是全项目统一的 3 次 —— 审议一次 LLM 调用就是真金白银, 重试 3 次 = 3 倍成本.
#   ⚠️ 非法值 (空串 / 非数字 / <0) 一律回退 1, 不抛错.
# ENGINE_DELIBERATION_FAILURE_THRESHOLD: 审议**熔断阈值** (WP67). 缺省 3.
#   同一个会话**连续**失败 3 次 → 熔断 (这个会话的影子审议暂时不入队, 省 LLM 调用).
#   ⚠️ **连续**失败 (成功一次就清零), 不是累计失败.
#   ⚠️ 非法值 (空串 / 非数字 / ≤0) 一律回退 3, 不抛错.
# ENGINE_DELIBERATION_COOLDOWN_MS: 审议**熔断冷却时长** (毫秒, WP67). 缺省 600000 (10 分钟).
#   熔断后等这么久才放**一个**请求进去试 (半开); 试成功就恢复, 试失败就重新等满一个周期.
#   ⚠️ 非法值 (空串 / 非数字 / ≤0) 一律回退 600000, 不抛错.
# ENGINE_DELIBERATION_INTENTION_LOCK_ROUNDS: 审议**意图锁定轮数** (WP68). 缺省 3.
#   选定一个意图后锁定几轮, 期间 LLM 的意图切换建议被忽略; 到期才允许切换, 切换后重新锁定.
#   ⚠️ 这是**工程种子值, 不是临床数字** —— PoC 跑完按督导反馈校准.
#   ⚠️ 填 0 = 关掉锁定机制 (做对照实验用); 非法值 (空串 / 非数字 / <0) 一律回退 3, 不抛错.
ENGINE_DELIBERATION_ENABLED=false
ENGINE_DELIBERATION_MODEL=
ENGINE_DELIBERATION_TIMEOUT_MS=
ENGINE_DELIBERATION_TEMPERATURE=
ENGINE_DELIBERATION_WORKER_CONCURRENCY=
ENGINE_DELIBERATION_MAX_RETRIES=
ENGINE_DELIBERATION_FAILURE_THRESHOLD=
ENGINE_DELIBERATION_COOLDOWN_MS=
ENGINE_DELIBERATION_INTENTION_LOCK_ROUNDS=

# ===== 上传与静态资源 (头像等) =====
# 头像等上传文件的本地存储目录 (相对路径按 process.cwd() 解析).
#   dev = ./uploads; 生产建议 /var/www/mofang/uploads (由 nginx 直接 serve).
UPLOAD_STORAGE_DIR=./uploads
# 上传文件的对外可访问基址 (前端拼完整 URL 用). 留空 = 走相对路径.
UPLOAD_PUBLIC_BASE_URL=

# ===== 管理后台 basic auth (admin-debug 模块) =====
# ⚠️ **生产必须配**, 否则匿名请求会被直接 401 (WP25 已把生产改成 fail-close).
#    留空 = dev 放行 / 生产拒绝 —— 生产放行等于把整场逐字稿公开.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASS=

# ===== RSA 字段级加密 (V1.1 企业字段加密) =====
# 生产从 .env 加载固定 keypair; dev 每次启动自动生成 (启动 log 有警告).
#   公钥: SPKI PEM; 私钥: PKCS8 PEM.
# ⚠️ .env 里写多行 PEM 时, 服务端会把 literal "\n" 还原成真换行
#    (兼容 9P mount cache / Windows CRLF / dotenv 的各种 parse 行为).
RSA_PUBLIC_KEY_PEM=
RSA_PRIVATE_KEY_PEM=

# ============================================================================
# 预留键 (当前代码**未接线**) —— 写在文档里, 但代码里查无读取点.
# ----------------------------------------------------------------------------
# 这些键来自 V6.0 期设计与历史实现, 现在**没有任何代码读它们** ——
# 配了不会生效 (改了也不会报错, 是最费时间的排障陷阱).
# 所以它们**全部注释掉**: 注释 = 不构成契约, 也就不会让人误以为"配了就能用".
#
# 要启用其中任何一个, 需要**先在代码里接上读取点**, 然后把它挪回上面的生效区
# —— 这条规则由 test/config/wp25-env-example-coverage.spec.ts 双向断言守住.
#
# ⚠️ 与文件底部「预留键 (读得到但未消费)」区的区别 (两类都是预留键, 性质不同):
#   · 这一区: 代码里**查无读取点** —— 连读都没读;
#   · 那一区: 代码**读得到** (读进 config 命名空间), 只是没人消费.
#   共同点: 两者都**不构成生效契约**, 照抄都不会改变任何行为.
#
# --- LLM 厂商的开关 / 基址 / 默认模型 (现役口径: 只有 *_API_KEY + 两个 DEFAULT_*_PROVIDER) ---
