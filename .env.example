# ============================================================
# mofang-nestjs 生产环境配置模板
# 复制 .env.example → .env, 然后改真值
# 永远不要把真实 .env 进 git
# ============================================================

NODE_ENV=production

# Server
PORT=3000
SWAGGER_PORT=8000

# ============================================================
# Auth (必填, 强随机)
# ============================================================
# 生成: openssl rand -base64 48
JWT_SECRET=PLEASE-CHANGE-TO-STRONG-RANDOM-48BYTES
JWT_REFRESH_SECRET=PLEASE-CHANGE-TO-STRONG-RANDOM-48BYTES
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session (auth/* demo 路由用, V3 删除)
SESSION_SECRET=PLEASE-CHANGE-TO-STRONG-RANDOM-48BYTES

# ============================================================
# Database — MySQL 8
# ============================================================
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mofang
DB_USER=mofang
DB_PASSWORD=PLEASE-CHANGE-TO-STRONG-PASSWORD
MYSQL_ROOT_PASSWORD=PLEASE-CHANGE-TO-STRONG-ROOT-PASSWORD

# ============================================================
# Redis (JWT blacklist / BullMQ / 验证码)
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=PLEASE-CHANGE-TO-STRONG-REDIS-PASSWORD
REDIS_DB=0
REDIS_KEY_PREFIX=mofang:prod

# ============================================================
# Email — SMTP (生产: 阿里云 / SendGrid / Mailgun)
# ============================================================
EMAIL_ENABLED=true
EMAIL_HOST=smtpdm.aliyun.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreply@mofang.cloud
EMAIL_PASS=PLEASE-CHANGE-TO-SMTP-PASSWORD
EMAIL_FROM=noreply@mofang.cloud
EMAIL_FROM_NAME=Mofang

# ============================================================
# SMS — 验证码通道 (生产: 阿里云 / 腾讯云)
# ============================================================
SMS_ENABLED=true
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=PLEASE-CHANGE-TO-ALIYUN-ACCESS-KEY
SMS_ACCESS_SECRET=PLEASE-CHANGE-TO-ALIYUN-ACCESS-SECRET
SMS_SIGN_NAME=Mofang
SMS_TEMPLATE_CODE=SMS_123456
SMS_REGION=ap-guangzhou

# ============================================================
# OAuth 第三方登录
# ============================================================
WECHAT_OAUTH_ENABLED=true
WECHAT_APP_ID=PLEASE-CHANGE-TO-WECHAT-APP-ID
WECHAT_APP_SECRET=PLEASE-CHANGE-TO-WECHAT-APP-SECRET
WECHAT_CALLBACK_URL=https://mofang.cloud/user/oauth/wechat/callback

GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=PLEASE-CHANGE-TO-GOOGLE-CLIENT-ID
GOOGLE_CLIENT_SECRET=PLEASE-CHANGE-TO-GOOGLE-CLIENT-SECRET
GOOGLE_CALLBACK_URL=https://mofang.cloud/user/oauth/google/callback

APPLE_OAUTH_ENABLED=true
APPLE_CLIENT_ID=com.mofang.cloud
APPLE_TEAM_ID=PLEASE-CHANGE-TO-APPLE-TEAM-ID
APPLE_KEY_ID=PLEASE-CHANGE-TO-APPLE-KEY-ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLEASE-CHANGE-TO-APPLE-P8-KEY\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL=https://mofang.cloud/user/oauth/apple/callback

# ============================================================
# 密码策略 (大厂生产标准)
# ============================================================
PASSWORD_HISTORY_LIMIT=5
PASSWORD_RESET_CYCLE_DAYS=90
PASSWORD_MIN_AGE_MINUTES=0
PASSWORD_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=30

# ============================================================
# 验证码
# ============================================================
EMAIL_TOKEN_TTL_MIN=30
SMS_CODE_TTL_MIN=5
SMS_CODE_LENGTH=6
SMS_RATE_LIMIT_PER_HOUR=10
PASSWORD_RESET_TOKEN_TTL_MIN=60

# ============================================================
# Soft delete (GDPR 合规)
# ============================================================
SOFT_DELETE_RETENTION_DAYS=30
SOFT_DELETE_CRON="0 3 * * *"

# ============================================================
# Prometheus metrics
# ============================================================
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ============================================================
# Sentry (异常上报)
# ============================================================
SENTRY_DSN=https://PLEASE-CHANGE-TO-SENTRY-DSN@sentry.io/123
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# ============================================================
# CORS (生产白名单, 逗号分隔)
# ============================================================
# 开发环境: CORS_ORIGINS=*
# 生产环境: CORS_ORIGINS=https://mofang.cloud,https://admin.mofang.cloud
CORS_ORIGINS=https://mofang.cloud,https://admin.mofang.cloud

# ============================================================
# Grafana (仅 monitoring profile 用)
# ============================================================
GRAFANA_PASSWORD=PLEASE-CHANGE-TO-GRAFANA-ADMIN-PASSWORD