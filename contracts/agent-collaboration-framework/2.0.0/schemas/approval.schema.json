{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-collaboration-framework:schema:approval:1.0.0",
  "title": "Agent Collaboration Framework - Approval Record Contract",
  "description": "审批记录契约。环内审批节点的结论必须落成记录并进入审计链；无记录视为未批准。审批是阻塞式的，记录必须带生效范围与有效期。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "approvalId",
    "taskId",
    "node",
    "decision",
    "scope",
    "approvedBy",
    "approvedAt",
    "validUntil"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approved-with-conditions"
          }
        }
      },
      "then": {
        "required": [
          "conditions"
        ],
        "properties": {
          "conditions": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "approvalId": {
      "type": "string",
      "pattern": "^APR-[0-9]+$",
      "description": "审批记录唯一标识，形如 APR-0001。"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z0-9]+-[0-9]+$",
      "description": "被审批的任务标识。"
    },
    "node": {
      "type": "string",
      "enum": [
        "policy-exception",
        "sensitive-action",
        "route-selection",
        "cross-task-change",
        "verdict-arbitration",
        "external-release"
      ],
      "description": "审批节点；取值口径与 schemas/contract-enums.json 的 approvalNodes 一致。"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "approved-with-conditions",
        "rejected"
      ],
      "description": "审批结论；取值口径与 schemas/contract-enums.json 的 approvalDecisions 一致。"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "生效范围（路径 / 动作 / 资源）；审批只在此范围内有效。"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "附带条件；decision 为 approved-with-conditions 时不得为空。"
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "有效期终点；一次性审批可填动作发生时刻或 null 并配合 maxUses。"
    },
    "maxUses": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "最大使用次数；一次性审批填 1。"
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "description": "批准方标识。"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "description": "批准时间（ISO 8601 带时区）。"
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ],
      "description": "批准依据摘要。"
    }
  }
}
