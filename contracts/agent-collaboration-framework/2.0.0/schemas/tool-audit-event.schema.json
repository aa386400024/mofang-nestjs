{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-collaboration-framework:schema:tool-audit-event:1.0.0",
  "title": "Agent Collaboration Framework - Tool Audit Event Contract",
  "description": "工具调用审计事件契约。每次工具调用追加一条事件；只追加不修改，支持按任务标识 / 角色 / 时间检索与回放。审计记录不得写机密正文。",
  "type": "object",
  "additionalProperties": true,
  "required": ["eventId", "actorRef", "correlationId", "toolId", "category", "sideEffect", "resources", "result", "recordedAt"],
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "denied"
          }
        }
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sideEffect": {
            "const": "sensitive"
          }
        }
      },
      "then": {
        "required": ["approvalId"],
        "properties": {
          "approvalId": {
            "type": "string",
            "pattern": "^APR-[0-9]+$"
          }
        }
      }
    }
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^AUD-[0-9]+$",
      "description": "审计事件唯一标识，形如 AUD-0001。"
    },
    "actorRef": {
      "type": "string",
      "minLength": 1,
      "description": "调用方角色或执行方标识。"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "description": "关联标识：可回放到任务 / 回执（推荐填 taskId）。"
    },
    "taskId": {
      "type": ["string", "null"],
      "description": "关联任务标识；无任务关联时为 null。"
    },
    "toolId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]*$",
      "description": "被调用工具标识。"
    },
    "category": {
      "type": "string",
      "enum": [
        "workspace-read",
        "workspace-write",
        "gate-execution",
        "version-control",
        "retrieval",
        "state-store",
        "artifact-archive",
        "artifact-publish"
      ],
      "description": "工具类别；取值口径与 schemas/contract-enums.json 的 toolCategories 一致。"
    },
    "sideEffect": {
      "type": "string",
      "enum": ["read-only", "restricted-write", "sensitive"],
      "description": "本次调用的副作用级别。"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "本次调用实际作用的资源范围。"
    },
    "result": {
      "type": "string",
      "enum": ["allowed", "denied"],
      "description": "放行或拒绝。"
    },
    "reason": {
      "type": ["string", "null"],
      "description": "拒绝原因；denied 时必填。"
    },
    "approvalId": {
      "type": ["string", "null"],
      "description": "敏感操作对应的审批记录标识；未审批的敏感操作不得出现在审计链中。"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "description": "调用记录时间（ISO 8601 带时区）。"
    }
  }
}
