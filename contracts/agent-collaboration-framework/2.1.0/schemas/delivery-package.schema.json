{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-collaboration-framework:schema:delivery-package:1.0.0",
  "title": "Agent Collaboration Framework - Delivery Package Contract",
  "description": "夜间交付包契约。自治循环结束（队列空 / 达上限 / 熔断）后生成的机读汇总，供人工早上验收。只存指针与汇总，不复制工件正文。字段组见 docs/autonomous-loop.md §7。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packageId",
    "cycle",
    "counts",
    "tasks",
    "deadLetters",
    "leftovers",
    "pendingApprovals",
    "queueSnapshot"
  ],
  "properties": {
    "packageId": {
      "type": "string",
      "minLength": 1,
      "description": "交付包唯一标识。"
    },
    "cycle": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "startedAt",
        "endedAt",
        "mode",
        "queueSize",
        "stopReason"
      ],
      "description": "汇总元信息。",
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "循环开始时间。"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "description": "循环结束时间。"
        },
        "mode": {
          "type": "string",
          "enum": [
            "human-on-the-loop",
            "human-in-the-loop"
          ],
          "description": "运行模式。"
        },
        "queueSize": {
          "type": "integer",
          "minimum": 0,
          "description": "循环开始时队列规模。"
        },
        "stopReason": {
          "type": "string",
          "enum": [
            "queue-empty",
            "limit-reached",
            "circuit-open",
            "human-stop"
          ],
          "description": "循环终止原因。"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "passed",
        "conditionalPass",
        "rejected",
        "failed",
        "deadLettered"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0,
          "description": "通过数。"
        },
        "conditionalPass": {
          "type": "integer",
          "minimum": 0,
          "description": "附条件通过数。"
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "description": "打回数。"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "失败数。"
        },
        "deadLettered": {
          "type": "integer",
          "minimum": 0,
          "description": "死信数。"
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "任务结论清单。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "taskId",
          "contextId",
          "type",
          "finalStatus",
          "artifactRefs",
          "repairCount"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]+$",
            "description": "任务标识。"
          },
          "contextId": {
            "type": "string",
            "minLength": 1,
            "description": "归组标识。"
          },
          "type": {
            "type": "string",
            "enum": [
              "implementation",
              "review",
              "investigation",
              "documentation",
              "fix",
              "verification"
            ],
            "description": "任务类型。"
          },
          "finalStatus": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "rejected",
              "canceled"
            ],
            "description": "终态。"
          },
          "reviewVerdict": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "passed",
              "conditional-pass",
              "rejected",
              null
            ],
            "description": "验收结论。"
          },
          "artifactRefs": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "taskSheet",
              "deliveryRecord"
            ],
            "properties": {
              "taskSheet": {
                "type": "string",
                "minLength": 1,
                "description": "任务单指针。"
              },
              "deliveryRecord": {
                "type": "string",
                "minLength": 1,
                "description": "交付记录指针。"
              },
              "reply": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "回执指针。"
              }
            },
            "description": "证据工件指针。"
          },
          "repairCount": {
            "type": "integer",
            "minimum": 0,
            "description": "返修次数。"
          }
        }
      }
    },
    "deadLetters": {
      "type": "array",
      "description": "死信清单。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "taskId",
          "failureEvidence",
          "attemptedPaths",
          "decisionPoint"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]+$",
            "description": "死信任务标识。"
          },
          "failureEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "失败证据（命令 + 退出码 + 计数）。"
          },
          "attemptedPaths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "已尝试路径。"
          },
          "decisionPoint": {
            "type": "string",
            "minLength": 1,
            "description": "建议人工决策点。"
          }
        }
      }
    },
    "leftovers": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "backlogItems",
        "openQuestions",
        "manualReviewList"
      ],
      "description": "遗留项。",
      "properties": {
        "backlogItems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "既有债登记。"
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "未决问题。"
        },
        "manualReviewList": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "人工复核清单。"
        }
      }
    },
    "pendingApprovals": {
      "type": "array",
      "description": "待批动作。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "taskId",
          "node",
          "action"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]+$",
            "description": "任务标识。"
          },
          "node": {
            "type": "string",
            "enum": [
              "policy-exception",
              "sensitive-action",
              "route-selection",
              "cross-task-change",
              "verdict-arbitration",
              "external-release"
            ],
            "description": "审批节点。"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "待批动作描述。"
          }
        }
      }
    },
    "queueSnapshot": {
      "type": "array",
      "description": "队列快照：循环结束时各状态任务的指针与状态。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "taskId",
          "status",
          "pointer"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]+$",
            "description": "任务标识。"
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "ready",
              "submitted",
              "working",
              "input-required",
              "completed",
              "failed",
              "canceled",
              "rejected",
              "auth-required"
            ],
            "description": "任务状态。"
          },
          "pointer": {
            "type": "string",
            "minLength": 1,
            "description": "任务单或索引记录指针。"
          }
        }
      }
    }
  }
}
