{
  "schemaRef": "urn:agent-collaboration-framework:schema:tool-contract:1.0.0",
  "note": "mofang-nestjs 适配层 L2 自治流水线工具声明；工具实现位于 scripts/orchestration/。字段对齐框架 tool-contract schema，具体命令与路径为本项目取值。",
  "tools": [
    {
      "toolId": "TOOL-STATE-STORE",
      "category": "state-persistence",
      "description": "状态索引与附加运行态的原子读写、租约字段管理；store 抽象隔离，后续可替换为 DB 持久化。",
      "sideEffect": "restricted-write",
      "allowedRoles": ["orchestrator"],
      "resources": ["docs/team/agent-orchestration/task-state-index.json", "docs/team/agent-orchestration/orchestration-state.json"],
      "inputs": {
        "description": "任务标识与待落盘的状态变更。",
        "params": [
          {
            "name": "taskId",
            "type": "string",
            "required": true,
            "description": "任务唯一标识，贯穿任务单 / 回执 / 索引。"
          },
          {
            "name": "mutation",
            "type": "object",
            "required": true,
            "description": "状态迁移、租约或工件指针变更；须幂等且可回溯。"
          }
        ]
      },
      "outputs": {
        "description": "返回更新后的索引条目与运行态快照。",
        "result": "对象：含 taskId、status、history、artifacts 指针与租约字段。",
        "errors": ["目标文件不可写", "租约冲突（任务已被其他执行者领单）", "索引结构非法"]
      }
    },
    {
      "toolId": "TOOL-ACCEPTANCE-RUNNER",
      "category": "acceptance-gate",
      "description": "V1–V6 机读护栏：工件存在性与非空、指针可达、链接可达、编码、结构断言；输出三级结论与人工复核清单。",
      "sideEffect": "read-only",
      "allowedRoles": ["orchestrator", "reviewer"],
      "resources": ["docs/worklog/pending/", "docs/worklog/completed/"],
      "inputs": {
        "description": "待验收任务单、回执与工件指针清单。",
        "params": [
          {
            "name": "taskId",
            "type": "string",
            "required": true,
            "description": "待验收任务标识。"
          },
          {
            "name": "receiptRef",
            "type": "string",
            "required": false,
            "description": "交付记录 / 回执文件路径；缺省时按索引工件指针解析。"
          }
        ]
      },
      "outputs": {
        "description": "返回护栏结果、验收结论与人工复核项。",
        "result": "对象：含 gateResults、verdict（passed / conditional-pass / rejected）、manualReviewList。",
        "errors": ["工件缺失或为空", "工件指针不可达", "文件编码异常", "结构断言不满足"]
      }
    },
    {
      "toolId": "TOOL-QUEUE-SCHEDULER",
      "category": "queue-scheduler",
      "description": "队列扫描、领单租约、超时释放、验收驱动状态迁移、返修提案与限次、死信隔离、队列快照生成。",
      "sideEffect": "restricted-write",
      "allowedRoles": ["orchestrator"],
      "resources": [
        "docs/team/agent-orchestration/task-state-index.json",
        "docs/team/agent-orchestration/orchestration-state.json",
        "docs/team/agent-orchestration/orchestration-snapshot.json"
      ],
      "inputs": {
        "description": "调度轮次参数；自治开关与返修上限由 config.json 声明。",
        "params": [
          {
            "name": "runMode",
            "type": "string",
            "required": false,
            "description": "单轮扫描（run-once）；自治模式默认关闭，须显式开启。"
          }
        ]
      },
      "outputs": {
        "description": "返回本轮领单、状态迁移、返修提案、死信与快照。",
        "result": "对象：含 claims、transitions、reworkProposals、deadLetters、snapshot。",
        "errors": ["租约超时未释放", "返修次数超限进入死信", "任务类型不在白名单", "配置非法"]
      }
    },
    {
      "toolId": "TOOL-DELIVERY-PACK",
      "category": "delivery-packing",
      "description": "汇总夜间交付包：验收结论、证据指针、死信任务、遗留项与待人工批准动作。",
      "sideEffect": "restricted-write",
      "allowedRoles": ["orchestrator"],
      "resources": ["docs/team/agent-orchestration/delivery-packs/"],
      "inputs": {
        "description": "交付包时间窗口。",
        "params": [
          {
            "name": "window",
            "type": "string",
            "required": false,
            "description": "汇总窗口（日期或轮次）；缺省取最近一轮。"
          }
        ]
      },
      "outputs": {
        "description": "返回交付包清单文件路径与摘要。",
        "result": "对象：含 packRef、conclusions、evidenceRefs、deadLetters、backlogItems、pendingApprovals。",
        "errors": ["窗口内无完成任务", "关键证据指针缺失"]
      }
    },
    {
      "toolId": "TOOL-IMPROVEMENT-LOG",
      "category": "knowledge-capture",
      "description": "候选改进台账：实现 / 验收 / 返修 / 死信复盘 / 评审发现的缺口与架构提升点结构化登记、去重、状态流转与汇总；抽取只产生候选，立项与终态须人工闸门流转。",
      "sideEffect": "restricted-write",
      "allowedRoles": ["orchestrator"],
      "resources": ["docs/team/agent-orchestration/improvement-log.json"],
      "inputs": {
        "description": "台账动作与候选条目字段。",
        "params": [
          {
            "name": "action",
            "type": "string",
            "required": true,
            "description": "list / extract / add / transition 之一。"
          },
          {
            "name": "entry",
            "type": "object",
            "required": false,
            "description": "候选字段：title、source、type、layer、relatedTaskId、evidence、impact、suggestion。"
          }
        ]
      },
      "outputs": {
        "description": "返回台账条目、状态流转结果与按状态 / 类型 / 来源的汇总计数。",
        "result": "对象：含 improvementId、status、history 与 summarize 计数。",
        "errors": ["字段或枚举非法", "候选重复", "状态迁移非法", "台账条目不存在"]
      }
    },
    {
      "toolId": "TOOL-ORCH-CLI",
      "category": "orchestration-cli",
      "description": "编排工具链命令入口：status / run-once / snapshot / pack / config；不直接操作桌面 GUI，桌面派发与回执衔接由执行代理单元在调度间隙完成。",
      "sideEffect": "restricted-write",
      "allowedRoles": ["orchestrator"],
      "resources": ["scripts/orchestration/", "docs/team/agent-orchestration/"],
      "inputs": {
        "description": "子命令与参数。",
        "params": [
          {
            "name": "subcommand",
            "type": "string",
            "required": true,
            "description": "status / run-once / snapshot / pack / config 之一。"
          },
          {
            "name": "args",
            "type": "object",
            "required": false,
            "description": "子命令附加参数。"
          }
        ]
      },
      "outputs": {
        "description": "返回子命令执行结果与退出状态。",
        "result": "对象：含 command、status、payload。",
        "errors": ["未知子命令", "配置读取失败", "护栏校验未通过"]
      }
    }
  ]
}
